---
import '@/styles/global.css';
import Header from '@/components/Header.astro';
import Footer from '@/components/Footer.astro';
import { IDIOMAS, IDIOMA_BASE, idiomaDeRuta, t, type Idioma } from '@/lib/i18n';
import { alternativas } from '@/lib/publicables';

interface Props {
  titulo: string;
  descripcion: string;
  imagen?: string;
  tipo?: 'website' | 'article' | 'book';
  /** Un nodo JSON-LD, o varios: un array se sirve como lista de nodos sueltos,
      que es como se describe la obra Y su ruta de migas en la misma página. */
  jsonLd?: Record<string, unknown> | Record<string, unknown>[];
  anchoCompleto?: boolean;
  /** Fuera del índice. Para la 404 y cualquier página que no sea contenido. */
  noindex?: boolean;
  /** Idiomas en que existe ESTA página. Una ficha de obra pasa los suyos para
      que hreflang y el selector no ofrezcan versiones que no se generaron. */
  idiomas?: Idioma[];
}

const {
  titulo,
  descripcion,
  imagen = '/og-default.svg',
  tipo = 'website',
  jsonLd,
  anchoCompleto = false,
  noindex = false,
  idiomas,
} = Astro.props;

const idioma = idiomaDeRuta(Astro.url.pathname);
const meta = IDIOMAS[idioma];
const dic = t(idioma);

const canonical = new URL(Astro.url.pathname, Astro.site).toString();
const imagenAbs = new URL(imagen, Astro.site).toString();
const idiomasAlternos = alternativas(Astro.url.pathname, idiomas);
const SITIO = 'ManhwaToNovel';
// Se lee en el build (variable de entorno de Cloudflare Pages), no en cliente.
const TOKEN_ANALYTICS = import.meta.env.PUBLIC_CF_ANALYTICS_TOKEN ?? '';
---

<!doctype html>
<html lang={meta.htmlLang} dir={meta.dir} class="scroll-pt-24">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{titulo}</title>
    <meta name="description" content={descripcion} />
    {noindex && <meta name="robots" content="noindex, follow" />}
    <link rel="canonical" href={canonical} />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />

    {/* Una etiqueta por idioma con URL propia + x-default al idioma base. */}
    {
      idiomasAlternos.map((a) => (
        <link rel="alternate" hreflang={a.hreflang} href={new URL(a.href, Astro.site).toString()} />
      ))
    }
    <link
      rel="alternate"
      hreflang="x-default"
      href={new URL(idiomasAlternos.find((a) => a.idioma === IDIOMA_BASE)!.href, Astro.site).toString()}
    />

    <meta property="og:type" content={tipo} />
    <meta property="og:site_name" content={SITIO} />
    <meta property="og:title" content={titulo} />
    <meta property="og:description" content={descripcion} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={imagenAbs} />
    <meta property="og:locale" content={meta.ogLocale} />
    {
      idiomasAlternos
        .filter((a) => a.idioma !== idioma)
        .map((a) => <meta property="og:locale:alternate" content={IDIOMAS[a.idioma].ogLocale} />)
    }
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={titulo} />
    <meta name="twitter:description" content={descripcion} />
    <meta name="twitter:image" content={imagenAbs} />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=Literata:opsz,wght@7..72,400;7..72,500&display=swap"
    />

    {jsonLd && <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />}

    {/* Cloudflare Web Analytics: gratis, sin límite de visitas y sin cookies —
        por eso el sitio no necesita banner de consentimiento, que es fricción
        justo antes del primer scroll. Sin el token no se emite nada, así que
        `npm run dev` y los clones sin credenciales no cargan ningún script. */}
    {
      TOKEN_ANALYTICS && (
        <script
          is:inline
          defer
          src="https://static.cloudflareinsights.com/beacon.min.js"
          data-cf-beacon={`{"token": "${TOKEN_ANALYTICS}"}`}
        />
      )
    }

    <slot name="head" />

    {/* Anti-FOUC: corre antes del primer pintado */}
    <script is:inline>
      (() => {
        const t = localStorage.getItem('mtn:tema') || 'system';
        const oscuro =
          t === 'dark' ||
          (t === 'system' && matchMedia('(prefers-color-scheme: dark)').matches);
        document.documentElement.classList.toggle('dark', oscuro);
        document.documentElement.dataset.tema = t;
        const tam = localStorage.getItem('mtn:tamano');
        if (tam) document.documentElement.style.setProperty('--tamano-lectura', tam);
      })();
    </script>

    {/* Portadas rotas: al fallar una imagen, se prueban las alternativas de otras
        fuentes (data-fb) y, si ninguna carga, un placeholder. Así ningún ícono
        roto por link muerto de una scan. En captura porque el error de <img> no
        burbujea, y registrado en <head> para atrapar el error de cualquier img. */}
    <script is:inline>
      addEventListener(
        'error',
        (e) => {
          const img = e.target;
          if (!img || img.tagName !== 'IMG') return;
          let fb = [];
          try {
            fb = JSON.parse(img.dataset.fb || '[]');
          } catch (_) {}
          const sig = fb.shift();
          if (sig) {
            img.dataset.fb = JSON.stringify(fb);
            img.src = sig;
          } else if (img.dataset.fbDone !== '1') {
            img.dataset.fbDone = '1';
            img.src = '/portadas/espadachin.svg';
          }
        },
        true,
      );
    </script>
  </head>

  <body class="min-h-dvh flex flex-col">
    <a
      href="#contenido"
      class="sr-only focus:not-sr-only focus:absolute focus:top-3 focus:left-3 focus:z-50 neu rounded-xl px-4 py-2"
      >{dic.saltarContenido}</a
    >
    <Header idiomas={idiomas} />
    <main
      id="contenido"
      class:list={[
        'flex-1 w-full mx-auto px-4 sm:px-6 py-8',
        anchoCompleto ? 'max-w-6xl' : 'max-w-4xl',
      ]}
    >
      <slot />
    </main>
    <Footer />

    <script>
      import { init } from '@/lib/progress';
      init();
    </script>

    {/* Cloudflare Web Analytics: mide el tráfico en el dominio real (sin cookies,
        privacy-friendly). Antes solo medía el .pages.dev porque el beacon vivía
        ahí; en el dominio propio estaba en modo "snippet manual" y no se había
        puesto. El .pages.dev ya redirige aquí (301), así que no se duplica. */}
    <script
      is:inline
      type="module"
      src="https://static.cloudflareinsights.com/beacon.min.js"
      data-cf-beacon='{"token": "a0297c97343840d6b85ccebfd8d885ff"}'
    ></script>
  </body>
</html>
