---
import { t, type Idioma } from '@/lib/i18n';

/**
 * Rejilla de «últimos capítulos», como la portada de Olympus/ZonaTMO: portada
 * grande, título encima y los dos capítulos más nuevos debajo. Es lo primero que
 * busca quien vuelve cada día —«¿salió el capítulo?»— y por eso va arriba.
 *
 * La hora se pinta en el build y el script la reescribe en relativo («hace 2
 * h») con el reloj del lector: la página vive horas en el edge y un «hace 5 min»
 * horneado mentiría.
 */
export interface ItemUltimo {
  slug: string;
  titulo: string;
  portada: string;
  portadas: string[];
  href: string;
  formatos: ('manhwa' | 'novela')[];
  cuando: string;
  capitulos: { numero: number; href: string }[];
}

interface Props {
  items: ItemUltimo[];
  idioma: Idioma;
}

const { items, idioma } = Astro.props;
const dic = t(idioma);
const fecha = new Intl.DateTimeFormat(idioma, { day: 'numeric', month: 'short' });
---

<ul class="grid grid-cols-2 min-[480px]:grid-cols-3 md:grid-cols-4 lg:grid-cols-6 gap-3 sm:gap-4">
  {
    items.map((it) => (
      <li class="group min-w-0">
        <a
          href={it.href}
          class="relative block aspect-[3/4] overflow-hidden rounded-xl neu-sm"
          aria-label={it.titulo}
        >
          <img
            src={it.portada}
            data-fb={JSON.stringify(it.portadas.filter((u) => u !== it.portada))}
            alt=""
            width="240"
            height="320"
            loading="lazy"
            decoding="async"
            class="absolute inset-0 size-full object-cover transition-transform duration-300 group-hover:scale-105"
          />
          <span class="absolute left-1.5 top-1.5 flex gap-1 text-[10px] font-semibold uppercase tracking-wide">
            {it.formatos.map((f) => (
              <span class:list={['rounded-md px-1.5 py-0.5 text-white', f === 'manhwa' ? 'bg-emerald-600/90' : 'bg-acento-500/90']}>
                {dic.formato(f)}
              </span>
            ))}
          </span>
          <span class="absolute inset-x-0 bottom-0 bg-gradient-to-t from-black/90 via-black/55 to-transparent px-2 pb-2 pt-12">
            <span class="block text-center text-[13px] sm:text-sm font-semibold leading-snug text-white line-clamp-2 [text-shadow:0_1px_2px_rgb(0_0_0/.6)]">
              {it.titulo}
            </span>
          </span>
        </a>
        <div class="mt-1.5 grid grid-cols-2 gap-1.5">
          {it.capitulos.map((c, i) => (
            <a
              href={c.href}
              class="neu-inset rounded-lg px-1 py-1.5 text-center leading-tight transition-colors hover:text-acento-500 min-h-11 flex flex-col justify-center"
            >
              <span class="block text-xs font-medium text-base-700 dark:text-base-200 tabular-nums">{dic.capAbrev(c.numero)}</span>
              {i === 0 && (
                <time data-rel datetime={it.cuando} class="block text-[10px] text-base-400">
                  {fecha.format(new Date(it.cuando))}
                </time>
              )}
            </a>
          ))}
        </div>
      </li>
    ))
  }
</ul>

<script>
  // «hace 38 min» / «38 min ago» con el reloj del lector y en su idioma. Lo de
  // menos de un día va en rojo: es lo que Olympus marca con la llama.
  const lang = document.documentElement.lang;
  const rtf = new Intl.RelativeTimeFormat(lang, { numeric: 'auto', style: 'short' });
  const PASOS: [Intl.RelativeTimeFormatUnit, number][] = [
    ['minute', 60],
    ['hour', 24],
    ['day', 7],
    ['week', 4.35],
    ['month', 12],
  ];
  document.querySelectorAll<HTMLTimeElement>('time[data-rel]').forEach((el) => {
    let v = (Date.parse(el.dateTime) - Date.now()) / 60000;
    if (Number.isNaN(v)) return;
    let unidad: Intl.RelativeTimeFormatUnit = 'minute';
    for (const [u, tope] of PASOS) {
      unidad = u;
      if (Math.abs(v) < tope) break;
      v /= tope;
      unidad = 'year';
    }
    el.textContent = rtf.format(Math.round(v), unidad);
    if (Date.now() - Date.parse(el.dateTime) < 86400000) el.classList.add('text-rose-500', 'font-medium');
  });
</script>
