---
import { t, type Idioma } from '@/lib/i18n';

/**
 * Rejilla de «últimos capítulos», como la portada de Olympus/ZonaTMO: portada
 * grande, título encima y los dos capítulos más nuevos debajo. Es lo primero que
 * busca quien vuelve cada día —«¿salió el capítulo?»— y por eso va arriba.
 *
 * Paginada en el cliente (POR_PAGINA por página): todas las tarjetas van en el
 * HTML —son enlaces que Google rastrea— y las de otras páginas llevan `hidden`,
 * así sus portadas (lazy) no se descargan hasta que se piden.
 *
 * La hora se pinta en el build y el script la reescribe en relativo («hace 2
 * h») con el reloj del lector: la página vive horas en el edge y un «hace 5 min»
 * horneado mentiría. Menos de un día va en rojo; menos de 6 h, «Nuevo».
 */
export interface ItemUltimo {
  slug: string;
  titulo: string;
  portada: string;
  portadas: string[];
  href: string;
  formatos: ('manhwa' | 'novela')[];
  cuando: string;
  capitulos: { numero: number; href: string }[];
}

interface Props {
  items: ItemUltimo[];
  idioma: Idioma;
}

const POR_PAGINA = 12;
const { items, idioma } = Astro.props;
const dic = t(idioma);
const fecha = new Intl.DateTimeFormat(idioma, { day: 'numeric', month: 'short' });
const paginas = Math.ceil(items.length / POR_PAGINA);
---

<div data-ultimos data-por-pagina={POR_PAGINA}>
  <ul class="grid grid-cols-2 min-[480px]:grid-cols-3 md:grid-cols-4 lg:grid-cols-6 gap-3 sm:gap-4">
    {
      items.map((it, i) => (
        <li class="group min-w-0" hidden={i >= POR_PAGINA}>
          <a
            href={it.href}
            class="relative block aspect-[3/4] overflow-hidden rounded-xl neu-sm"
            aria-label={it.titulo}
          >
            <img
              src={it.portada}
              data-fb={JSON.stringify(it.portadas.filter((u) => u !== it.portada))}
              alt=""
              width="240"
              height="320"
              loading="lazy"
              decoding="async"
              class="absolute inset-0 size-full object-cover transition-transform duration-300 group-hover:scale-105"
            />
            <span class="absolute left-1.5 top-1.5 flex gap-1 text-[10px] font-semibold uppercase tracking-wide">
              {it.formatos.map((f) => (
                <span class:list={['rounded-md px-1.5 py-0.5 text-white', f === 'manhwa' ? 'bg-emerald-600/90' : 'bg-acento-500/90']}>
                  {dic.formato(f)}
                </span>
              ))}
            </span>
            <span
              data-nuevo
              hidden
              class="absolute right-1.5 top-1.5 rounded-md bg-rose-600 px-1.5 py-0.5 text-[10px] font-bold uppercase tracking-wide text-white shadow"
            >{dic.nuevo}</span>
            <span class="absolute inset-x-0 bottom-0 bg-gradient-to-t from-black/90 via-black/55 to-transparent px-2 pb-2 pt-12">
              <span class="block text-center text-[13px] sm:text-sm font-semibold leading-snug text-white line-clamp-2 [text-shadow:0_1px_2px_rgb(0_0_0/.6)]">
                {it.titulo}
              </span>
            </span>
          </a>
          <div class="mt-1.5 grid grid-cols-2 gap-1.5">
            {it.capitulos.map((c, j) => (
              <a
                href={c.href}
                class="neu-inset rounded-lg px-1 py-1.5 text-center leading-tight transition-colors hover:text-acento-500 min-h-11 flex flex-col justify-center"
              >
                <span class="block text-xs font-medium text-base-700 dark:text-base-200 tabular-nums">{dic.capAbrev(c.numero)}</span>
                {j === 0 && (
                  <time data-rel datetime={it.cuando} class="block text-[10px] text-base-400">
                    {fecha.format(new Date(it.cuando))}
                  </time>
                )}
              </a>
            ))}
          </div>
        </li>
      ))
    }
  </ul>

  {
    paginas > 1 && (
      <nav data-paginador aria-label={dic.pagina} class="mt-5 flex items-center justify-center gap-1 flex-wrap">
        <button data-ir="-1" aria-label={dic.anterior} class="size-9 rounded-xl neu-sm neu-press text-lg leading-none disabled:opacity-30">‹</button>
        {Array.from({ length: paginas }, (_, i) => (
          <button
            data-pagina={i}
            aria-label={`${dic.pagina} ${i + 1}`}
            aria-current={i === 0 ? 'page' : undefined}
            class="size-9 rounded-xl neu-sm neu-press text-sm font-medium tabular-nums aria-[current=page]:bg-acento-500 aria-[current=page]:text-white"
          >{i + 1}</button>
        ))}
        <button data-ir="1" aria-label={dic.siguiente} class="size-9 rounded-xl neu-sm neu-press text-lg leading-none disabled:opacity-30">›</button>
      </nav>
    )
  }
</div>

<script>
  // «hace 38 min» / «38 min ago» con el reloj del lector y en su idioma.
  const lang = document.documentElement.lang;
  const rtf = new Intl.RelativeTimeFormat(lang, { numeric: 'auto', style: 'short' });
  const PASOS: [Intl.RelativeTimeFormatUnit, number][] = [
    ['minute', 60],
    ['hour', 24],
    ['day', 7],
    ['week', 4.35],
    ['month', 12],
  ];
  document.querySelectorAll<HTMLTimeElement>('[data-ultimos] time[data-rel]').forEach((el) => {
    let v = (Date.parse(el.dateTime) - Date.now()) / 60000;
    if (Number.isNaN(v)) return;
    let unidad: Intl.RelativeTimeFormatUnit = 'minute';
    for (const [u, tope] of PASOS) {
      unidad = u;
      if (Math.abs(v) < tope) break;
      v /= tope;
      unidad = 'year';
    }
    el.textContent = rtf.format(Math.round(v), unidad);
    const edad = Date.now() - Date.parse(el.dateTime);
    if (edad < 86400000) el.classList.add('text-rose-500', 'font-medium');
    // «Nuevo» solo en lo de las últimas 6 h: un scrapeo toca decenas de obras
    // a la vez, y una etiqueta que sale en todas no destaca ninguna.
    const nuevo = el.closest('li')?.querySelector<HTMLElement>('[data-nuevo]');
    if (nuevo && edad < 6 * 3600000) nuevo.hidden = false;
  });

  // Paginador: muestra una página y deja las demás con `hidden`.
  document.querySelectorAll<HTMLElement>('[data-ultimos]').forEach((raiz) => {
    const nav = raiz.querySelector<HTMLElement>('[data-paginador]');
    if (!nav) return;
    const por = Number(raiz.dataset.porPagina);
    const tarjetas = [...raiz.querySelectorAll<HTMLElement>('ul > li')];
    const botones = [...nav.querySelectorAll<HTMLButtonElement>('[data-pagina]')];
    const [prev, next] = [nav.querySelector<HTMLButtonElement>('[data-ir="-1"]')!, nav.querySelector<HTMLButtonElement>('[data-ir="1"]')!];
    let actual = 0;
    const ir = (p: number, desplazar = true) => {
      actual = Math.max(0, Math.min(botones.length - 1, p));
      tarjetas.forEach((li, i) => (li.hidden = Math.floor(i / por) !== actual));
      botones.forEach((b, i) => (i === actual ? b.setAttribute('aria-current', 'page') : b.removeAttribute('aria-current')));
      prev.disabled = actual === 0;
      next.disabled = actual === botones.length - 1;
      // Al cambiar de página, volver al principio de la rejilla si quedó arriba.
      const arriba = raiz.getBoundingClientRect().top;
      if (desplazar && arriba < 0) raiz.scrollIntoView({ behavior: 'smooth', block: 'start' });
    };
    botones.forEach((b) => b.addEventListener('click', () => ir(Number(b.dataset.pagina))));
    prev.addEventListener('click', () => ir(actual - 1));
    next.addEventListener('click', () => ir(actual + 1));
    ir(0, false);
  });
</script>
