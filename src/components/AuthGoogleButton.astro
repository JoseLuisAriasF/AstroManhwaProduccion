---
// Botón único: iniciar sesión cuando no hay sesión, avatar + salir cuando la hay.
import { idiomaDeRuta, ruta, t } from '@/lib/i18n';

const dic = t(idiomaDeRuta(Astro.url.pathname));
---

<div class="relative" id="auth">
  <button
    id="auth-login"
    type="button"
    class="neu-sm neu-press rounded-xl px-3 py-2 text-sm flex items-center gap-2 whitespace-nowrap"
  >
    <svg viewBox="0 0 24 24" class="size-4" aria-hidden="true">
      <path fill="#4285F4" d="M23 12.3c0-.8-.1-1.6-.2-2.3H12v4.5h6.2a5.3 5.3 0 0 1-2.3 3.5v2.9h3.7c2.2-2 3.4-5 3.4-8.6Z"/>
      <path fill="#34A853" d="M12 24c3.1 0 5.7-1 7.6-2.8l-3.7-2.9c-1 .7-2.3 1.1-3.9 1.1-3 0-5.5-2-6.4-4.7H1.8v3A12 12 0 0 0 12 24Z"/>
      <path fill="#FBBC05" d="M5.6 14.7a7.2 7.2 0 0 1 0-4.6v-3H1.8a12 12 0 0 0 0 10.6l3.8-3Z"/>
      <path fill="#EA4335" d="M12 4.8c1.7 0 3.2.6 4.4 1.7l3.3-3.3A11.6 11.6 0 0 0 12 0 12 12 0 0 0 1.8 6.1l3.8 3C6.5 6.7 9 4.8 12 4.8Z"/>
    </svg>
    <span class="hidden sm:inline">{dic.entrarConGoogle}</span>
  </button>

  <button id="auth-user" type="button" hidden class="neu-sm neu-press rounded-xl p-1 pr-3 flex items-center gap-2 text-sm">
    <img id="auth-avatar" alt="" class="size-7 rounded-lg object-cover bg-base-300" />
    <span id="auth-nombre" class="hidden sm:inline max-w-24 truncate"></span>
  </button>

  <div id="auth-menu" hidden class="absolute right-0 mt-2 w-52 neu rounded-2xl p-2 text-sm z-50">
    <a href={ruta(idiomaDeRuta(Astro.url.pathname), "/biblioteca")} class="block rounded-xl px-3 py-2 hover:bg-base-200/60 dark:hover:bg-base-800/60">{dic.navBiblioteca}</a>
    <button id="auth-logout" class="w-full text-left rounded-xl px-3 py-2 text-red-500 hover:bg-base-200/60 dark:hover:bg-base-800/60">{dic.cerrarSesion}</button>
  </div>
</div>

<script>
  import { supabase, loginConGoogle, logout } from '@/lib/supabaseClient';

  const login = document.getElementById('auth-login') as HTMLButtonElement;
  const chip = document.getElementById('auth-user') as HTMLButtonElement;
  const menu = document.getElementById('auth-menu') as HTMLDivElement;
  const avatar = document.getElementById('auth-avatar') as HTMLImageElement;
  const nombre = document.getElementById('auth-nombre') as HTMLSpanElement;

  if (!supabase) {
    login.title = document.documentElement.lang.startsWith('en') ? 'Set PUBLIC_SUPABASE_URL to enable syncing' : 'Configura PUBLIC_SUPABASE_URL para habilitar la sincronización';
  }

  login.addEventListener('click', loginConGoogle);
  document.getElementById('auth-logout')!.addEventListener('click', logout);
  chip.addEventListener('click', () => (menu.hidden = !menu.hidden));
  document.addEventListener('click', (e) => {
    if (!(e.target as Element).closest('#auth')) menu.hidden = true;
  });

  window.addEventListener('auth:change', (e) => {
    const user = (e as CustomEvent).detail;
    login.hidden = !!user;
    chip.hidden = !user;
    if (user) {
      avatar.src = user.user_metadata?.avatar_url ?? '';
      nombre.textContent = user.user_metadata?.full_name?.split(' ')[0] ?? '—';
    }
  });
</script>
