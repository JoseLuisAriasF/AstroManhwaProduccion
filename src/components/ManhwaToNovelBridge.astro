---
import { idiomaDeRuta, ruta, t } from '@/lib/i18n';
import type { EquivalenciaManhwa } from '@/types/novela';

interface Props {
  slug: string;
  anclas: EquivalenciaManhwa[];
  /** Se muestra aunque no haya anclas: la obra tiene manhwa Y novela, así que la
      comunidad puede aportar/votar la primera equivalencia. */
  mostrar?: boolean;
  compacto?: boolean;
}

const { slug, anclas, mostrar = false, compacto = false } = Astro.props;
const idioma = idiomaDeRuta(Astro.url.pathname);
const dic = t(idioma);
---

{
  (anclas.length > 0 || mostrar) && (
    <section
      class:list={['neu rounded-2xl', compacto ? 'p-4' : 'p-5 sm:p-6']}
      data-cruce
      data-slug={slug}
      data-base={ruta(idioma, `/novela/${slug}`)}
      aria-labelledby={`cruce-${slug}`}
    >
      <div class="flex items-start gap-3">
        <span class="neu-inset shrink-0 grid place-items-center size-9 rounded-xl text-acento-500">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" class="size-4">
            <path d="M4 7h9m0 0-3-3m3 3-3 3M20 17h-9m0 0 3-3m-3 3 3 3" />
          </svg>
        </span>
        <div class="min-w-0">
          <h2 id={`cruce-${slug}`} class="font-semibold text-base-800 dark:text-base-100">
            {dic.puenteTitulo}
          </h2>
          <p class="text-sm text-base-500 mt-0.5">{dic.puenteComunidadSub}</p>
        </div>
      </div>

      {/* Fallback SEO/no-JS: las anclas oficiales en HTML estático. El script las
          reemplaza por la lista interactiva y votada. */}
      <ol data-lista class="mt-4 grid gap-2 text-sm">
        {anclas
          .slice()
          .sort((a, b) => a.capituloManhwa - b.capituloManhwa)
          .map((a) => (
            <li class="neu-inset rounded-xl px-3 py-2 tabular-nums">
              {dic.puenteCapManhwa} <b>{a.capituloManhwa}</b> {dic.puenteEqCapNovela} <b>{a.capituloNovela}</b>
            </li>
          ))}
      </ol>

      <p data-cruce-vacio hidden class="mt-4 text-sm text-base-500">{dic.puenteVacio}</p>

      {/* Aporte / voto. El script revela el formulario según haya sesión. */}
      <div class="mt-4 border-t border-base-300/40 dark:border-base-700/40 pt-4">
        <div data-cruce-form hidden>
          <p class="text-sm text-base-500 mb-2">{dic.puenteAporta}</p>
          <div class="flex flex-wrap items-center gap-2 text-sm">
            <span class="text-base-500">{dic.puenteCapManhwa}</span>
            <input type="number" min="1" data-aporte-manhwa class="neu-inset rounded-lg w-16 px-2 py-1.5 bg-transparent outline-none tabular-nums" />
            <span class="text-base-500">{dic.puenteEqCapNovela}</span>
            <input type="number" min="1" data-aporte-novela class="neu-inset rounded-lg w-16 px-2 py-1.5 bg-transparent outline-none tabular-nums" />
            <button data-aporte-enviar class="neu-sm neu-press rounded-lg px-3 py-1.5 font-medium text-acento-500">
              {dic.puenteAportar}
            </button>
          </div>
          <p data-aporte-msg hidden class="mt-2 text-xs" />
        </div>

        <p data-cruce-login hidden class="text-xs text-base-400">
          Inicia sesión con Google (arriba a la derecha) para aportar y votar equivalencias.
        </p>
      </div>
    </section>
  )
}

<script>
  import { supabase } from '@/lib/supabaseClient';
  import { idiomaDeRuta, t } from '@/lib/i18n';

  const dic = t(idiomaDeRuta(location.pathname));

  type Fila = { capitulo_manhwa: number; capitulo_novela: number };

  for (const caja of document.querySelectorAll<HTMLElement>('[data-cruce]')) {
    const slug = caja.dataset.slug!;
    const lista = caja.querySelector<HTMLElement>('[data-lista]')!;
    const vacio = caja.querySelector<HTMLElement>('[data-cruce-vacio]')!;
    const form = caja.querySelector<HTMLElement>('[data-cruce-form]')!;
    const avisoLogin = caja.querySelector<HTMLElement>('[data-cruce-login]')!;
    const inM = caja.querySelector<HTMLInputElement>('[data-aporte-manhwa]')!;
    const inN = caja.querySelector<HTMLInputElement>('[data-aporte-novela]')!;
    const enviar = caja.querySelector<HTMLButtonElement>('[data-aporte-enviar]')!;
    const msg = caja.querySelector<HTMLElement>('[data-aporte-msg]')!;

    let usuarioId: string | null = null;

    const mostrarMsg = (texto: string, ok: boolean) => {
      msg.textContent = texto;
      msg.className = `mt-2 text-xs ${ok ? 'text-emerald-500' : 'text-red-500'}`;
      msg.hidden = false;
    };

    /** Registra (o cambia) el voto del usuario para un cap. de manhwa. */
    async function votar(capManhwa: number, capNovela: number) {
      if (!supabase || !usuarioId) return;
      const { error } = await supabase.from('equivalencias_sugeridas').upsert(
        { obra_slug: slug, capitulo_manhwa: capManhwa, capitulo_novela: capNovela, usuario_id: usuarioId },
        { onConflict: 'obra_slug,capitulo_manhwa,usuario_id' },
      );
      if (error) {
        const esLimite = /aporte|l[ií]mite|d[ií]a/i.test(error.message);
        mostrarMsg(esLimite ? error.message : dic.puenteNoGuardado, false);
        return;
      }
      mostrarMsg(dic.puenteVotoOk, true);
      await cargar();
    }

    function render(admin: Map<number, number>, com: Map<number, Map<number, number>>, mias: Map<number, number>) {
      const caps = [...new Set([...admin.keys(), ...com.keys()])].sort((a, b) => a - b);
      if (caps.length === 0) {
        lista.hidden = true;
        vacio.hidden = false;
        return;
      }
      vacio.hidden = true;
      lista.hidden = false;
      lista.innerHTML = caps
        .map((cap) => {
          const oficial = admin.get(cap);
          const opciones = [...(com.get(cap) ?? new Map<number, number>()).entries()].sort(
            (a, b) => b[1] - a[1] || a[0] - b[0],
          );
          const ganadora = oficial ?? opciones[0]?.[0];
          const votosGana = oficial ? 0 : (opciones[0]?.[1] ?? 0);
          const miVoto = mias.get(cap);
          const badge = oficial
            ? `<span class="text-[11px] text-acento-500 neu-inset rounded px-1.5 py-0.5">${dic.puenteOficial}</span>`
            : `<span class="text-[11px] text-base-400">${dic.puenteVotos(votosGana)}</span>`;

          // Alternativas con menos votos (para "ver detalle").
          const alternativas = opciones
            .filter(([nov]) => nov !== ganadora)
            .map(([nov, v]) => {
              const yo = miVoto === nov ? ` · <span class="text-emerald-500">${dic.puenteTuVoto}</span>` : '';
              const botn = usuarioId && miVoto !== nov
                ? ` <button data-votar="${cap}:${nov}" class="text-acento-500 underline ml-1">${dic.puenteVotar}</button>`
                : '';
              return `<li class="text-base-500">${dic.puenteCapNovela} <b>${nov}</b> · ${dic.puenteVotos(v)}${yo}${botn}</li>`;
            })
            .join('');
          const votarGanadora =
            usuarioId && !oficial && miVoto !== ganadora
              ? ` <button data-votar="${cap}:${ganadora}" class="text-acento-500 underline ml-1">${dic.puenteVotar}</button>`
              : '';
          const tuVotoGana = miVoto === ganadora ? ` · <span class="text-emerald-500">${dic.puenteTuVoto}</span>` : '';
          const detalle =
            alternativas.length || (usuarioId && !oficial)
              ? `<details class="mt-1"><summary class="cursor-pointer text-[11px] text-base-400">${dic.puenteVerDetalle}</summary>
                   <ul class="mt-1 grid gap-1 text-xs pl-1">${alternativas}${oficial && opciones.length ? `<li class="text-base-400">${dic.puentePropuestas}</li>` : ''}</ul>
                 </details>`
              : '';

          return `<li class="neu-inset rounded-xl px-3 py-2">
            <div class="tabular-nums">${dic.puenteCapManhwa} <b>${cap}</b> ${dic.puenteEqCapNovela} <b>${ganadora}</b> ${badge}${tuVotoGana}${votarGanadora}</div>
            ${detalle}
          </li>`;
        })
        .join('');

      lista.querySelectorAll<HTMLButtonElement>('[data-votar]').forEach((b) =>
        b.addEventListener('click', () => {
          const [c, n] = b.dataset.votar!.split(':').map(Number);
          votar(c, n);
        }),
      );
    }

    async function cargar() {
      if (!supabase) return;
      const [adminR, comR, miaR] = await Promise.all([
        supabase.from('equivalencias').select('capitulo_manhwa,capitulo_novela').eq('novela_slug', slug),
        supabase.from('equivalencias_sugeridas').select('capitulo_manhwa,capitulo_novela').eq('obra_slug', slug),
        usuarioId
          ? supabase.from('equivalencias_sugeridas').select('capitulo_manhwa,capitulo_novela').eq('obra_slug', slug).eq('usuario_id', usuarioId)
          : Promise.resolve({ data: [] as Fila[] }),
      ]);
      const admin = new Map<number, number>((adminR.data ?? []).map((r: Fila) => [r.capitulo_manhwa, r.capitulo_novela]));
      const com = new Map<number, Map<number, number>>();
      for (const r of (comR.data ?? []) as Fila[]) {
        const op = com.get(r.capitulo_manhwa) ?? new Map<number, number>();
        op.set(r.capitulo_novela, (op.get(r.capitulo_novela) ?? 0) + 1);
        com.set(r.capitulo_manhwa, op);
      }
      const mias = new Map<number, number>(((miaR.data ?? []) as Fila[]).map((r) => [r.capitulo_manhwa, r.capitulo_novela]));
      render(admin, com, mias);
    }

    async function init() {
      if (!supabase) return;
      const { data } = await supabase.auth.getUser();
      usuarioId = data.user?.id ?? null;
      form.hidden = !usuarioId;
      avisoLogin.hidden = !!usuarioId;

      enviar.addEventListener('click', () => {
        const m = parseInt(inM.value, 10);
        const n = parseInt(inN.value, 10);
        if (!Number.isFinite(m) || !Number.isFinite(n) || m < 1 || n < 1) {
          mostrarMsg(dic.puenteNumsInvalidos, false);
          return;
        }
        inM.value = '';
        inN.value = '';
        votar(m, n);
      });

      await cargar();
    }

    init();
  }
</script>
