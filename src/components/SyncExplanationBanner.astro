---
// Explica el modelo de guardado. Se oculta al iniciar sesión o si el lector lo cierra.
import { idiomaDeRuta, t } from '@/lib/i18n';

const dic = t(idiomaDeRuta(Astro.url.pathname));
---

<aside
  id="sync-banner"
  hidden
  class="neu rounded-2xl p-4 sm:p-5 flex gap-4 items-start"
  aria-live="polite"
>
  <span class="neu-inset shrink-0 grid place-items-center size-10 rounded-xl text-acento-500">
    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" class="size-5">
      <path d="M20 12a8 8 0 0 0-13.7-5.6L4 8.5M4 12a8 8 0 0 0 13.7 5.6L20 15.5" />
      <path d="M4 4v4.5h4.5M20 20v-4.5h-4.5" />
    </svg>
  </span>

  <div class="min-w-0 flex-1">
    <p class="text-sm leading-relaxed text-base-600 dark:text-base-300">
      {dic.bannerTexto}{' '}
      <strong class="font-semibold text-base-800 dark:text-base-100">{dic.bannerEnEsteDispositivo}</strong>{dic.bannerResto}
    </p>
    <div class="mt-3 flex flex-wrap gap-2">
      <button id="sync-banner-login" class="neu-sm neu-press rounded-xl px-3 py-2 text-sm font-medium text-acento-500">
        {dic.bannerSincronizar}
      </button>
      <button id="sync-banner-close" class="rounded-xl px-3 py-2 text-sm text-base-500 hover:text-base-700 dark:hover:text-base-200 transition-colors">
        {dic.bannerInvitado}
      </button>
    </div>
  </div>
</aside>

<script>
  import { loginConGoogle } from '@/lib/supabaseClient';

  const banner = document.getElementById('sync-banner') as HTMLElement;
  const OCULTO = 'mtn:banner-oculto';

  if (localStorage.getItem(OCULTO) !== '1') banner.hidden = false;

  document.getElementById('sync-banner-login')!.addEventListener('click', loginConGoogle);
  document.getElementById('sync-banner-close')!.addEventListener('click', () => {
    localStorage.setItem(OCULTO, '1');
    banner.hidden = true;
  });
  window.addEventListener('auth:change', (e) => {
    if ((e as CustomEvent).detail) banner.hidden = true;
  });
</script>
