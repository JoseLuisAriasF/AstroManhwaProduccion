---
import type { CapituloExterno } from '@/types/novela';
import { IDIOMAS, esIdioma, idiomaDeRuta, t } from '@/lib/i18n';
import { restoDelTitulo } from '@/lib/capitulos';
import { abreEnVisor, urlDeLectura } from '@/lib/fuentes';

interface Fuente {
  fuenteId: string;
  nombre: string;
  tipo: 'manhwa' | 'novela';
  idioma: string;
  dominio: string;
  ultimo: number;
  total: number;
  soloEnlace: boolean;
  recortada: boolean;
  capitulos: CapituloExterno[];
}

interface Props {
  fuentes: Fuente[];
  slug: string;
}

const { fuentes, slug } = Astro.props;
const idiomaPagina = idiomaDeRuta(Astro.url.pathname);
const dic = t(idiomaPagina);
const enIngles = idiomaPagina === 'en';

const idiomaNombre = (i: string) => (esIdioma(i) ? IDIOMAS[i].nombre : i.toUpperCase());
/** Capítulos por página. Con 1.000, llegar al 1 era hacer scroll hasta el fondo. */
const POR_PAGINA = 50;
---

{
  fuentes.length > 0 && (
    <section aria-label={dic.fuenteAria} data-caps-externos data-slug={slug}>
      <div class="flex items-center gap-3 mb-3">
        <h2 class="font-semibold text-base-800 dark:text-base-100">{dic.dondeLeerla}</h2>
        <label class="neu-inset rounded-xl px-3 py-1.5 ml-auto flex items-center gap-2">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" class="size-4 text-base-400">
            <circle cx="11" cy="11" r="7" /><path d="m20 20-4-4" stroke-linecap="round" />
          </svg>
          <input
            type="search"
            data-filtro
            placeholder={dic.filtroCapitulo}
            aria-label={dic.filtrarCapitulos}
            class="w-24 bg-transparent outline-none text-sm"
          />
        </label>
      </div>

      {/*
        Una tarjeta por scan, como zonascans. Se pican para elegir la fuente;
        vienen ordenadas por número de capítulos, la más completa primero.
      */}
      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-3 mb-4" role="tablist">
        {fuentes.map((f, i) => (
          <button
            role="tab"
            data-fuente={f.fuenteId}
            aria-selected={i === 0 ? 'true' : 'false'}
            class="neu-sm neu-press rounded-2xl p-3 text-left flex flex-col gap-1 aria-selected:ring-2 aria-selected:ring-acento-500/60"
          >
            <div class="flex items-center gap-2">
              <span
                class:list={[
                  'text-[11px] font-medium rounded-lg px-2 py-0.5 neu-inset',
                  f.tipo === 'novela' ? 'text-acento-500' : 'text-emerald-500',
                ]}
              >
                {dic.formato(f.tipo)}
              </span>
              <span class="text-[11px] text-base-400">{idiomaNombre(f.idioma)}</span>
            </div>
            <span class="font-semibold text-base-800 dark:text-base-100 truncate">{f.nombre}</span>
            <span class="text-sm text-base-400 tabular-nums">
              {`${f.total} ${dic.capitulosCorto}`}
              {!f.soloEnlace && f.ultimo > 0 && <span class="text-base-500"> · último {f.ultimo}</span>}
            </span>
          </button>
        ))}
      </div>

      {fuentes.map((f, i) => (
        <div data-panel={f.fuenteId} hidden={i !== 0}>
          {/* Decir de dónde sale cada enlace no es letra chica: es el sitio. */}
          <p class="text-sm text-base-500 mb-3">
            {dic.fuenteInfo(dic.formato(f.tipo), idiomaNombre(f.idioma), f.total)}{' '}
            <strong class="text-base-600 dark:text-base-300">{f.dominio}</strong>.
            {f.soloEnlace ? dic.fuenteSoloEnlace : dic.fuenteSeLeen}
            {f.recortada && (
              <>
                {' '}{dic.mostramosUltimos(f.capitulos.length, f.total)}
                {/* También en la ventana: este era el último enlace de la ficha
                    que todavía se llevaba al lector a otra pestaña. */}
                <a
                  href={`https://${f.dominio}`}
                  target="_blank"
                  rel="noopener nofollow"
                  data-visor-src={
                    abreEnVisor(`https://${f.dominio}`) ? urlDeLectura(`https://${f.dominio}`) : undefined
                  }
                  data-etiqueta={dic.todosCapitulos(f.nombre)}
                  data-donde={f.dominio}
                  class="text-acento-500 underline"
                >
                  {dic.verTodosEn(f.dominio)}
                </a>.
              </>
            )}
          </p>

          {/* Paginador + orden. Sin JS no hace nada: se ven todos, como antes.
              «Desde el cap. 1» invierte la lista: quien empieza la obra no tiene
              que ir a la última página a buscar el primero. */}
          {f.capitulos.length > POR_PAGINA && (
            <div data-pager hidden class="mb-3 flex flex-wrap items-center gap-2 text-sm">
              <div class="flex rounded-xl neu-inset p-1" role="group">
                <button
                  data-orden="desc"
                  aria-pressed="true"
                  class="rounded-lg px-3 py-1.5 font-medium text-base-500 aria-pressed:bg-acento-500 aria-pressed:text-white"
                >{dic.masRecientes}</button>
                <button
                  data-orden="asc"
                  aria-pressed="false"
                  class="rounded-lg px-3 py-1.5 font-medium text-base-500 aria-pressed:bg-acento-500 aria-pressed:text-white"
                >{dic.desdeElPrimero}</button>
              </div>
              <div class="ml-auto flex items-center gap-1">
                <button data-pg="-1" aria-label={dic.anterior} class="size-9 rounded-lg neu-sm neu-press text-lg leading-none disabled:opacity-30">‹</button>
                <select data-pg-sel aria-label={dic.pagina} class="neu-inset rounded-lg bg-transparent px-2 py-1.5 text-sm tabular-nums max-w-[11rem]"></select>
                <button data-pg="1" aria-label={dic.siguiente} class="size-9 rounded-lg neu-sm neu-press text-lg leading-none disabled:opacity-30">›</button>
              </div>
            </div>
          )}

          <ol class="grid gap-2">
            {f.capitulos.map((c) => {
              // Una sola pasada del regex por fila: en una obra de 2.000
              // capítulos, llamarlo en la condición y otra vez en el valor son
              // 4.000 ejecuciones por página, y hay 8.600 páginas.
              const resto = enIngles
                ? restoDelTitulo(c.titulo, c.numero)?.replace(
                    /^(Serie|Novela) completa · (\d+) capítulos$/,
                    (_, f, n) => `${f === 'Serie' ? 'Full series' : 'Full novel'} · ${n} chapters`,
                  )
                : restoDelTitulo(c.titulo, c.numero);
              return (
              <li
                data-cap={c.numero ?? ''}
                data-leido="false"
                class="neu-sm rounded-xl flex items-center gap-3 px-3 py-2 transition-opacity duration-200"
              >
                {/* `target="_blank"` y el `href` de la fuente se quedan: si el
                    JS no corre, el enlace lleva al sitio original como siempre.
                    El visor es una mejora encima, no un requisito. */}
                <a
                  href={c.url}
                  target="_blank"
                  rel="noopener nofollow"
                  data-visor-src={abreEnVisor(c.url) ? urlDeLectura(c.url) : undefined}
                  data-etiqueta={c.numero !== null ? dic.capNumero(c.numero) : c.titulo}
                  data-donde={f.dominio}
                  class="min-w-0 flex-1 flex items-baseline gap-2 py-0.5"
                >
                  {/* "Capítulo 1200", no "1200": es la frase con la que se busca
                      un capítulo suelto, y solo cuenta si está escrita aquí. La
                      escribe el sitio (en su idioma) y no la scan, que la trae
                      como le da la gana o no la trae. */}
                  {c.numero !== null && (
                    <span class="font-medium tabular-nums whitespace-nowrap text-base-700 dark:text-base-200">
                      {dic.capNumero(c.numero)}
                    </span>
                  )}
                  {/* Del título de la scan solo lo que AÑADE: casi siempre es el
                      número otra vez, y se leía "Capítulo 1200 · Capítulo 1200". */}
                  {resto && <span class="truncate text-sm text-base-500">{resto}</span>}
                  <svg
                    viewBox="0 0 24 24"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="1.7"
                    stroke-linecap="round"
                    class="size-3.5 shrink-0 text-base-400"
                    aria-hidden="true"
                  >
                    <path d="M7 17 17 7M9 7h8v8" />
                  </svg>
                  <span class="sr-only">{dic.seAbreEn(f.dominio)}</span>
                </a>

                {c.fecha_texto && (
                  <span class="shrink-0 text-[11px] text-base-400 hidden sm:block">{c.fecha_texto}</span>
                )}
              </li>
              );
            })}
          </ol>
        </div>
      ))}

      {/* ── La ventana de lectura ──────────────────────────────────────────
          Abre el capítulo encima de la ficha en vez de mandar al lector a otra
          pestaña. Una sola para toda la lista: el `src` se pone al abrirla y se
          borra al cerrarla, así no hay 2.000 iframes en el HTML ni se queda un
          reproductor sonando de fondo.

          `<dialog>` nativo: el Esc, el foco y el fondo los pone el navegador.

          El `sandbox` es la otra mitad del bloqueo de publicidad: sin
          `allow-popups` no hay popunder que valga —son la mitad de los anuncios
          de una scan y la CSP de /leer no los para, porque los abre el JS de la
          propia página—. Lo que carga el capítulo (scripts, imágenes) sigue
          permitido. */}
      <dialog
        data-visor
        class="w-screen h-[100dvh] max-w-none max-h-none m-0 p-0 border-0 bg-base-900 backdrop:bg-black/80"
      >
        <div class="flex h-full flex-col">
          {/* La barra, lo más baja posible: la pantalla es para el capítulo. */}
          <header class="flex items-center gap-3 px-3 h-11 shrink-0 bg-base-900 text-base-100">
            <span data-visor-titulo class="font-medium text-sm truncate"></span>
            {/* Encadenar capítulos SIN cerrar la ventana. Cada cierre es una
                oportunidad de que el lector se vaya del sitio: si para seguir
                leyendo hay que cerrar, buscar en la lista y volver a abrir, se
                pierde a mucha gente por el camino. Con esto se lee la obra
                entera de un tirón. Las flechas del teclado hacen lo mismo
                mientras el foco no se haya ido dentro del capítulo. */}
            <div class="ml-auto flex items-center gap-0.5 shrink-0">
              <button
                data-visor-prev
                aria-label={dic.anterior}
                title={`${dic.anterior} (←)`}
                class="grid place-items-center size-9 rounded-lg text-xl leading-none text-base-300 hover:text-white hover:bg-white/10 active:bg-white/20 disabled:opacity-30 disabled:pointer-events-none"
              >‹</button>
              <button
                data-visor-next
                aria-label={dic.siguiente}
                title={`${dic.siguiente} (→)`}
                class="grid place-items-center size-9 rounded-lg text-xl leading-none text-base-300 hover:text-white hover:bg-white/10 active:bg-white/20 disabled:opacity-30 disabled:pointer-events-none"
              >›</button>
            </div>
            <a
              data-visor-abrir
              href="#"
              target="_blank"
              rel="noopener nofollow"
              class="shrink-0 text-xs text-acento-400 hover:underline"></a>
            {/* 44 px: el mínimo que se acierta con el pulgar sin mirar. Cerrar
                rápido es la mitad del valor de leer aquí dentro. */}
            <button
              data-visor-cerrar
              aria-label={dic.cerrar}
              title={`${dic.cerrar} (Esc)`}
              class="shrink-0 grid place-items-center size-11 -mr-2 rounded-xl text-2xl leading-none text-base-300 hover:text-white hover:bg-white/10 active:bg-white/20"
            >✕</button>
          </header>
          {/* Lo que NO va, y por qué:
              · `allow-top-navigation`: una scan con frame-busting se llevaría al
                lector fuera del sitio de un salto.
              · `allow-popups`: es el popunder, el anuncio que más molesta.
              · `allow-same-origin`: el documento de /leer se sirve desde NUESTRO
                dominio, así que con esto el JS de la scan leería nuestro
                localStorage —progreso y sesión de Supabase incluidos—. Antes del
                proxy daba igual (era su origen); ahora no. */}
          <iframe
            data-visor-marco
            title={dic.visorMarco}
            sandbox="allow-scripts allow-forms"
            class="flex-1 w-full border-0 bg-white"></iframe>
        </div>
      </dialog>
    </section>
  )
}

<script>
  import { leido, marcarLeido } from '@/lib/progress';
  import { idiomaDeRuta, t } from '@/lib/i18n';

  const dic = t(idiomaDeRuta(location.pathname));

  const lista = document.querySelector<HTMLElement>('[data-caps-externos]');
  if (lista) {
    const slug = lista.dataset.slug!;
    const filas = [...lista.querySelectorAll<HTMLElement>('[data-cap]')];

    // Filas con `numero` conocido pueden marcarse; las de numero null son
    // spinoffs/tocantes sin equivalencia numérica y quedan fuera del tracking.
    const conNumero = filas.filter((f) => f.dataset.cap !== '');

    // El progreso es por obra, no por scan: leer el capítulo 40 en una fuente
    // lo marca también en las demás. Es el mismo capítulo de la misma historia.
    const pintar = () =>
      conNumero.forEach((f) => {
        const l = leido(slug, +f.dataset.cap!);
        f.dataset.leido = String(l);
        f.style.opacity = l ? '0.6' : '';
      });
    pintar();

    // Click en el enlace → marca leído. Como es target=_blank la navegación
    // no cancela el handler y la escritura en localStorage llega antes del blur.
    conNumero.forEach((f) => {
      f.querySelector('a')?.addEventListener('click', () => {
        marcarLeido(slug, +f.dataset.cap!);
      });
    });

    // ── La ventana de lectura ────────────────────────────────────────────────
    // El capítulo se pide a /leer, que lo trae de la fuente (functions/leer.ts).
    // Por ahí entran TODAS: pedirlo desde el edge es lo que salta el
    // `X-Frame-Options` que dejaba fuera al 57 % de los capítulos.
    //
    // Un click con ctrl/cmd/shift, o con el botón central, sigue abriendo una
    // pestaña. Es lo que espera cualquiera que quiera varios capítulos a la vez,
    // y secuestrarlo es la forma más rápida de que el lector odie el visor.
    const visor = lista.querySelector<HTMLDialogElement>('[data-visor]');
    const marco = visor?.querySelector<HTMLIFrameElement>('[data-visor-marco]');
    const rotulo = visor?.querySelector<HTMLElement>('[data-visor-titulo]');
    const abrir = visor?.querySelector<HTMLAnchorElement>('[data-visor-abrir]');

    const irPrev = visor?.querySelector<HTMLButtonElement>('[data-visor-prev]');
    const irNext = visor?.querySelector<HTMLButtonElement>('[data-visor-next]');

    if (visor && marco && rotulo && abrir && irPrev && irNext) {
      // ── Encadenar capítulos dentro de la ventana ──────────────────────────
      // `cadena` son los capítulos de la MISMA scan, del más nuevo al más
      // viejo; `pos` es dónde estamos. Se recalcula al abrir y no antes: hasta
      // entonces no se sabe de qué panel salió el click.
      let cadena: HTMLAnchorElement[] = [];
      let pos = -1;

      /** Los capítulos numerados del panel de esa scan, de mayor a menor. Los
       *  spinoffs sin número quedan fuera: no hay "siguiente" de algo que no
       *  está en la cuenta. */
      const cadenaDe = (a: HTMLAnchorElement) =>
        [...(a.closest('[data-panel]') ?? lista).querySelectorAll<HTMLAnchorElement>('a[data-visor-src]')]
          .map((el) => {
            // `data-cap` va vacío en los spinoffs, y `Number('')` es 0 —no NaN—,
            // así que sin este guardia se colarían como "capítulo 0".
            const cap = el.closest<HTMLElement>('[data-cap]')?.dataset.cap;
            return { el, n: cap ? Number(cap) : NaN };
          })
          .filter((x) => Number.isFinite(x.n))
          .sort((x, y) => y.n - x.n)
          .map((x) => x.el);

      const mostrar = (a: HTMLAnchorElement) => {
        rotulo.textContent = `${a.dataset.etiqueta ?? ''} · ${a.dataset.donde ?? ''}`.trim();
        abrir.href = a.href; // la fuente de verdad, no /leer
        abrir.textContent = dic.abrirEnFuente(a.dataset.donde ?? '');
        marco.src = a.dataset.visorSrc!;
        const cap = a.closest<HTMLElement>('[data-cap]')?.dataset.cap;
        if (cap) marcarLeido(slug, +cap);
        // La cadena va de mayor a menor, así que el capítulo SIGUIENTE está una
        // posición ANTES. Con `pos` a -1 (un capítulo suelto, sin número) se
        // apagan las dos flechas solas.
        pos = cadena.indexOf(a);
        irNext.disabled = pos <= 0;
        irPrev.disabled = pos < 0 || pos >= cadena.length - 1;
      };

      const saltar = (i: number) => {
        if (i >= 0 && i < cadena.length) mostrar(cadena[i]);
      };

      lista.querySelectorAll<HTMLAnchorElement>('a[data-visor-src]').forEach((a) => {
        a.addEventListener('click', (e) => {
          if (e.metaKey || e.ctrlKey || e.shiftKey || e.altKey || e.button !== 0) return;
          e.preventDefault();
          cadena = cadenaDe(a);
          // Abrir ANTES de pedir el capítulo: mientras el dialog está cerrado es
          // display:none, y hay navegadores que no cargan el iframe de un
          // elemento sin pintar.
          visor.showModal();
          mostrar(a);
        });
      });

      irPrev.addEventListener('click', () => saltar(pos + 1));
      irNext.addEventListener('click', () => saltar(pos - 1));

      // Las flechas, mientras el foco siga en la ventana. En cuanto el lector
      // pica DENTRO del capítulo el foco pasa al iframe —que es de otro origen—
      // y sus teclas ya no se oyen aquí; por eso los botones son los que mandan
      // y esto es un atajo, no la única forma.
      visor.addEventListener('keydown', (e) => {
        if (e.key === 'ArrowLeft') saltar(pos + 1);
        else if (e.key === 'ArrowRight') saltar(pos - 1);
      });

      // Vaciar el marco al cerrar no es cosmético: si no, la página de la scan
      // sigue viva detrás —sonando, pidiendo imágenes— hasta recargar la ficha.
      //
      // Se hace en las tres salidas y NO solo en el evento `close`. Medido: hay
      // navegadores donde ese evento no llega, y entonces el marco se quedaba
      // corriendo. `cancel` cubre el Esc, que es la salida que no pasa por
      // ningún click nuestro.
      const olvidarHash = () => {
        if (location.hash.startsWith('#capitulo-')) history.replaceState(null, '', location.pathname + location.search);
      };
      const cerrar = () => {
        marco.removeAttribute('src');
        visor.close();
        olvidarHash();
      };
      visor.querySelector('[data-visor-cerrar]')?.addEventListener('click', cerrar);
      visor.addEventListener('click', (e) => {
        if (e.target === visor) cerrar(); // el fondo ES el propio <dialog>
      });
      visor.addEventListener('cancel', () => marco.removeAttribute('src')); // Esc
      visor.addEventListener('close', () => {
        marco.removeAttribute('src');
        olvidarHash();
      });
    }

    window.addEventListener('progress:change', pintar);
    window.addEventListener('progress:synced', pintar);

    // Tarjetas de scan: al elegir una, se muestra su lista de capítulos.
    const tarjetas = [...lista.querySelectorAll<HTMLButtonElement>('[data-fuente]')];
    tarjetas.forEach((b) =>
      b.addEventListener('click', () => {
        tarjetas.forEach((o) => o.setAttribute('aria-selected', String(o === b)));
        lista.querySelectorAll<HTMLElement>('[data-panel]').forEach((p) => {
          p.hidden = p.dataset.panel !== b.dataset.fuente;
        });
      }),
    );

    // ── Paginador por scan ─────────────────────────────────────────────────
    // Las filas se ocultan con `hidden`; el orden se invierte moviendo los <li>
    // (la cadena del visor ordena por número, así que no le afecta).
    const POR = 50;
    const pagers = new Map<HTMLElement, { aPagina: (f: HTMLElement) => void; reaplicar: () => void; pager: HTMLElement }>();
    lista.querySelectorAll<HTMLElement>('[data-panel]').forEach((panel) => {
      const pager = panel.querySelector<HTMLElement>('[data-pager]');
      const ol = panel.querySelector<HTMLOListElement>('ol');
      if (!pager || !ol) return;
      const sel = pager.querySelector<HTMLSelectElement>('[data-pg-sel]')!;
      const prev = pager.querySelector<HTMLButtonElement>('[data-pg="-1"]')!;
      const next = pager.querySelector<HTMLButtonElement>('[data-pg="1"]')!;
      const orden = [...pager.querySelectorAll<HTMLButtonElement>('[data-orden]')];
      const filasDe = () => [...ol.children] as HTMLElement[];
      let actual = 0;
      const construir = () => {
        const fs = filasDe();
        sel.innerHTML = Array.from({ length: Math.ceil(fs.length / POR) }, (_, i) => {
          const ns = fs.slice(i * POR, (i + 1) * POR).map((f) => f.dataset.cap).filter(Boolean).map(Number);
          const texto = ns.length ? dic.rangoCaps(ns[0], ns[ns.length - 1]) : `${dic.pagina} ${i + 1}`;
          return `<option value="${i}">${texto}</option>`;
        }).join('');
      };
      const ir = (p: number) => {
        const fs = filasDe();
        const total = Math.ceil(fs.length / POR);
        actual = Math.max(0, Math.min(total - 1, p));
        fs.forEach((f, i) => (f.hidden = Math.floor(i / POR) !== actual));
        sel.value = String(actual);
        prev.disabled = actual === 0;
        next.disabled = actual === total - 1;
      };
      const saltar = (p: number) => {
        ir(p);
        if (pager.getBoundingClientRect().top < 0) pager.scrollIntoView({ behavior: 'smooth', block: 'start' });
      };
      orden.forEach((b) =>
        b.addEventListener('click', () => {
          const asc = b.dataset.orden === 'asc';
          if ((ol.dataset.orden === 'asc') !== asc) {
            ol.append(...filasDe().reverse());
            ol.dataset.orden = asc ? 'asc' : 'desc';
          }
          orden.forEach((o) => o.setAttribute('aria-pressed', String(o === b)));
          construir();
          ir(0);
        }),
      );
      sel.addEventListener('change', () => saltar(Number(sel.value)));
      prev.addEventListener('click', () => saltar(actual - 1));
      next.addEventListener('click', () => saltar(actual + 1));
      construir();
      ir(0);
      pager.hidden = false;
      pagers.set(panel, {
        pager,
        aPagina: (f) => ir(Math.floor(filasDe().indexOf(f) / POR)),
        reaplicar: () => ir(actual),
      });
    });

    // Buscador por número, dentro del scan visible. Los spinoffs sin número
    // solo aparecen cuando la búsqueda está vacía (nada para hacer match).
    // Mientras se busca, el paginador se aparta: se ven los resultados de todas
    // las páginas.
    const filtro = lista.querySelector<HTMLInputElement>('[data-filtro]')!;
    filtro.addEventListener('input', () => {
      const q = filtro.value.trim();
      filas.forEach((f) => {
        const cap = f.dataset.cap!;
        const ocultar = q !== '' && (cap === '' || !cap.startsWith(q));
        f.style.display = ocultar ? 'none' : '';
        if (q !== '') f.hidden = false;
      });
      pagers.forEach((p) => {
        p.pager.hidden = q !== '';
        if (q === '') p.reaplicar();
      });
    });

    // ── #capitulo-N: llegar desde «Últimos capítulos» con el capítulo abierto ─
    // Se elige la scan que lo tiene y se puede leer aquí dentro (la primera en
    // el orden de tarjetas, que es la más completa); si ninguna, la primera que
    // lo tenga, y se deja marcado en la lista.
    const abrirHash = () => {
      const m = /^#capitulo-(\d+)$/.exec(location.hash);
      if (!m) return;
      const candidatas = [...lista.querySelectorAll<HTMLElement>(`[data-panel] li[data-cap="${m[1]}"]`)];
      const fila = candidatas.find((f) => f.querySelector('a[data-visor-src]')) ?? candidatas[0];
      if (!fila) {
        lista.scrollIntoView({ block: 'start' });
        return;
      }
      const panel = fila.closest<HTMLElement>('[data-panel]')!;
      tarjetas.find((b) => b.dataset.fuente === panel.dataset.panel)?.click();
      pagers.get(panel)?.aPagina(fila);
      fila.scrollIntoView({ block: 'center' });
      fila.classList.add('ring-2', 'ring-acento-500');
      fila.querySelector<HTMLAnchorElement>('a[data-visor-src]')?.click();
    };
    abrirHash();
    window.addEventListener('hashchange', abrirHash);
  }
</script>
