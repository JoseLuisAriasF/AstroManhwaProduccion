---
import type { CapituloExterno } from '@/types/novela';
import { IDIOMAS, esIdioma, idiomaDeRuta, t } from '@/lib/i18n';

interface Fuente {
  fuenteId: string;
  nombre: string;
  tipo: 'manhwa' | 'novela';
  idioma: string;
  dominio: string;
  ultimo: number;
  total: number;
  soloEnlace: boolean;
  recortada: boolean;
  capitulos: CapituloExterno[];
}

interface Props {
  fuentes: Fuente[];
  slug: string;
}

const { fuentes, slug } = Astro.props;
const dic = t(idiomaDeRuta(Astro.url.pathname));

const idiomaNombre = (i: string) => (esIdioma(i) ? IDIOMAS[i].nombre : i.toUpperCase());
const etiquetaTipo = (tipo: 'manhwa' | 'novela') => (tipo === 'manhwa' ? 'Manhwa' : 'Novela');
---

{
  fuentes.length > 0 && (
    <section aria-label="Fuentes donde leer" data-caps-externos data-slug={slug}>
      <div class="flex items-center gap-3 mb-3">
        <h2 class="font-semibold text-base-800 dark:text-base-100">{dic.dondeLeerla}</h2>
        <label class="neu-inset rounded-xl px-3 py-1.5 ml-auto flex items-center gap-2">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" class="size-4 text-base-400">
            <circle cx="11" cy="11" r="7" /><path d="m20 20-4-4" stroke-linecap="round" />
          </svg>
          <input
            type="search"
            data-filtro
            placeholder={dic.filtroCapitulo}
            aria-label={dic.filtrarCapitulos}
            class="w-24 bg-transparent outline-none text-sm"
          />
        </label>
      </div>

      {/*
        Una tarjeta por scan, como zonascans. Se pican para elegir la fuente;
        vienen ordenadas por número de capítulos, la más completa primero.
      */}
      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-3 mb-4" role="tablist">
        {fuentes.map((f, i) => (
          <button
            role="tab"
            data-fuente={f.fuenteId}
            aria-selected={i === 0 ? 'true' : 'false'}
            class="neu-sm neu-press rounded-2xl p-3 text-left flex flex-col gap-1 aria-selected:ring-2 aria-selected:ring-acento-500/60"
          >
            <div class="flex items-center gap-2">
              <span
                class:list={[
                  'text-[11px] font-medium rounded-lg px-2 py-0.5 neu-inset',
                  f.tipo === 'novela' ? 'text-acento-500' : 'text-emerald-500',
                ]}
              >
                {etiquetaTipo(f.tipo)}
              </span>
              <span class="text-[11px] text-base-400">{idiomaNombre(f.idioma)}</span>
            </div>
            <span class="font-semibold text-base-800 dark:text-base-100 truncate">{f.nombre}</span>
            <span class="text-sm text-base-400 tabular-nums">
              {f.total} {dic.capitulosCorto}
              {!f.soloEnlace && f.ultimo > 0 && <span class="text-base-500"> · último {f.ultimo}</span>}
            </span>
          </button>
        ))}
      </div>

      {fuentes.map((f, i) => (
        <div data-panel={f.fuenteId} hidden={i !== 0}>
          {/* Decir de dónde sale cada enlace no es letra chica: es el sitio. */}
          <p class="text-sm text-base-500 mb-3">
            {etiquetaTipo(f.tipo)} en {idiomaNombre(f.idioma)}, {f.total} capítulos en{' '}
            <strong class="text-base-600 dark:text-base-300">{f.dominio}</strong>.
            {f.soloEnlace
              ? ' Esta fuente no lista los capítulos aquí: el enlace lleva a su página, donde se elige y se lee.'
              : ' Se leen allí: cada enlace lleva a la fuente original y se marca como leído al hacer click.'}
            {f.recortada && (
              <>
                {' '}Mostramos los últimos {f.capitulos.length} de {f.total};{' '}
                <a href={`https://${f.dominio}`} target="_blank" rel="noopener nofollow" class="text-acento-500 underline">
                  ver todos en {f.dominio}
                </a>.
              </>
            )}
          </p>

          <ol class="grid gap-2">
            {f.capitulos.map((c) => (
              <li
                data-cap={c.numero ?? ''}
                data-leido="false"
                class="neu-sm rounded-xl flex items-center gap-3 px-3 py-2 transition-opacity duration-200"
              >
                <a
                  href={c.url}
                  target="_blank"
                  rel="noopener nofollow"
                  class="min-w-0 flex-1 flex items-baseline gap-2 py-0.5"
                >
                  {c.numero !== null && (
                    <span class="font-medium tabular-nums text-base-700 dark:text-base-200">{c.numero}</span>
                  )}
                  <span class="truncate text-sm text-base-500">{c.titulo}</span>
                  <svg
                    viewBox="0 0 24 24"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="1.7"
                    stroke-linecap="round"
                    class="size-3.5 shrink-0 text-base-400"
                    aria-hidden="true"
                  >
                    <path d="M7 17 17 7M9 7h8v8" />
                  </svg>
                  <span class="sr-only">(se abre en {f.dominio})</span>
                </a>

                {c.fecha_texto && (
                  <span class="shrink-0 text-[11px] text-base-400 hidden sm:block">{c.fecha_texto}</span>
                )}
              </li>
            ))}
          </ol>
        </div>
      ))}
    </section>
  )
}

<script>
  import { leido, marcarLeido } from '@/lib/progress';

  const lista = document.querySelector<HTMLElement>('[data-caps-externos]');
  if (lista) {
    const slug = lista.dataset.slug!;
    const filas = [...lista.querySelectorAll<HTMLElement>('[data-cap]')];

    // Filas con `numero` conocido pueden marcarse; las de numero null son
    // spinoffs/tocantes sin equivalencia numérica y quedan fuera del tracking.
    const conNumero = filas.filter((f) => f.dataset.cap !== '');

    // El progreso es por obra, no por scan: leer el capítulo 40 en una fuente
    // lo marca también en las demás. Es el mismo capítulo de la misma historia.
    const pintar = () =>
      conNumero.forEach((f) => {
        const l = leido(slug, +f.dataset.cap!);
        f.dataset.leido = String(l);
        f.style.opacity = l ? '0.6' : '';
      });
    pintar();

    // Click en el enlace → marca leído. Como es target=_blank la navegación
    // no cancela el handler y la escritura en localStorage llega antes del blur.
    conNumero.forEach((f) => {
      f.querySelector('a')?.addEventListener('click', () => {
        marcarLeido(slug, +f.dataset.cap!);
      });
    });

    window.addEventListener('progress:change', pintar);
    window.addEventListener('progress:synced', pintar);

    // Tarjetas de scan: al elegir una, se muestra su lista de capítulos.
    const tarjetas = [...lista.querySelectorAll<HTMLButtonElement>('[data-fuente]')];
    tarjetas.forEach((b) =>
      b.addEventListener('click', () => {
        tarjetas.forEach((o) => o.setAttribute('aria-selected', String(o === b)));
        lista.querySelectorAll<HTMLElement>('[data-panel]').forEach((p) => {
          p.hidden = p.dataset.panel !== b.dataset.fuente;
        });
      }),
    );

    // Buscador por número, dentro del scan visible. Los spinoffs sin número
    // solo aparecen cuando la búsqueda está vacía (nada para hacer match).
    const filtro = lista.querySelector<HTMLInputElement>('[data-filtro]')!;
    filtro.addEventListener('input', () => {
      const q = filtro.value.trim();
      filas.forEach((f) => {
        const cap = f.dataset.cap!;
        const ocultar = q !== '' && (cap === '' || !cap.startsWith(q));
        f.style.display = ocultar ? 'none' : '';
      });
    });
  }
</script>
