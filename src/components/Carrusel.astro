---
import type { EquivalenciaManhwa, Novela } from '@/types/novela';

interface Item {
  novela: Novela;
  formatos: ('manhwa' | 'novela')[];
  total: number;
  ancla: EquivalenciaManhwa | null;
  href: string;
}

interface Props {
  items: Item[];
  titulo: string;
}

const { items, titulo } = Astro.props;
---

{
  items.length > 0 && (
    <section class="relative" data-carrusel aria-roledescription="carrusel" aria-label={titulo}>
      <div class="flex items-center gap-2 mb-3">
        <h2 class="font-semibold text-base-800 dark:text-base-100">{titulo}</h2>
        <div class="ml-auto flex gap-1.5">
          <button data-prev aria-label="Anterior" class="neu-sm neu-press rounded-xl size-9 grid place-items-center text-base-500">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" class="size-4"><path d="m15 18-6-6 6-6" /></svg>
          </button>
          <button data-next aria-label="Siguiente" class="neu-sm neu-press rounded-xl size-9 grid place-items-center text-base-500">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" class="size-4"><path d="m9 18 6-6-6-6" /></svg>
          </button>
        </div>
      </div>

      <div data-track class="flex overflow-x-auto snap-x snap-mandatory gap-4 scrollbar-none scroll-smooth -mx-4 px-4 sm:mx-0 sm:px-0">
        {items.map((it) => (
          <a
            href={it.href}
            data-slide
            class="group snap-center shrink-0 w-full sm:w-[calc(100%-3.5rem)] relative rounded-3xl overflow-hidden neu"
          >
            {/* Fondo: la portada borrosa llena el banner; el gradiente da contraste al texto. */}
            <img
              src={it.novela.portadaUrl}
              alt=""
              aria-hidden="true"
              class="absolute inset-0 w-full h-full object-cover blur-2xl scale-125 opacity-50"
            />
            <div class="absolute inset-0 bg-gradient-to-r from-black/85 via-black/55 to-black/20" />

            <div class="relative flex gap-4 sm:gap-6 p-4 sm:p-6 min-h-[13rem] sm:min-h-[15rem] items-center">
              <img
                src={it.novela.portadaUrl}
                alt={it.novela.titulo}
                width="128"
                height="183"
                loading="lazy"
                decoding="async"
                class="w-24 sm:w-32 aspect-[7/10] object-cover rounded-2xl shrink-0 shadow-2xl ring-1 ring-white/10 transition-transform duration-300 group-hover:scale-105"
              />

              <div class="min-w-0 text-white">
                <div class="flex flex-wrap gap-1.5 mb-2">
                  {it.formatos.map((f) => (
                    <span
                      class:list={[
                        'text-[11px] font-semibold rounded-md px-2 py-0.5 capitalize',
                        f === 'manhwa' ? 'bg-emerald-500/90' : 'bg-acento-500/90',
                      ]}
                    >
                      {f}
                    </span>
                  ))}
                  {it.total > 0 && (
                    <span class="text-[11px] font-medium rounded-md px-2 py-0.5 bg-white/15 tabular-nums">
                      {it.total} cap.
                    </span>
                  )}
                </div>

                <h3 class="text-lg sm:text-2xl font-bold leading-tight line-clamp-2 text-balance">
                  {it.novela.titulo}
                </h3>
                {it.novela.titulosAlternativos[0] && (
                  <p class="text-sm text-white/60 line-clamp-1 mt-0.5">{it.novela.titulosAlternativos[0]}</p>
                )}

                {/* El gancho del sitio, dentro de la imagen: la equivalencia. */}
                {it.ancla && (
                  <div class="mt-2.5 inline-flex items-center gap-1.5 text-xs sm:text-sm bg-white/15 backdrop-blur rounded-lg px-2.5 py-1 font-medium tabular-nums">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" class="size-3.5 text-acento-300">
                      <path d="M4 7h9m0 0-3-3m3 3-3 3M20 17h-9m0 0 3-3m-3 3 3 3" />
                    </svg>
                    Manhwa {it.ancla.capituloManhwa} = Novela {it.ancla.capituloNovela}
                  </div>
                )}

                <span class="mt-3 hidden sm:inline-flex items-center gap-1 text-sm font-medium text-white/90 group-hover:text-white">
                  Ver ficha
                  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" class="size-4"><path d="m9 18 6-6-6-6" /></svg>
                </span>
              </div>
            </div>
          </a>
        ))}
      </div>

      <div data-dots class="flex justify-center gap-1.5 mt-3">
        {items.map((_, i) => (
          <button
            data-dot={i}
            aria-label={`Ir al ${i + 1}`}
            class="size-2 rounded-full bg-base-300 dark:bg-base-600 aria-[current]:bg-acento-500 aria-[current]:w-5 transition-all"
          />
        ))}
      </div>
    </section>
  )
}

<script>
  for (const car of document.querySelectorAll<HTMLElement>('[data-carrusel]')) {
    const track = car.querySelector<HTMLElement>('[data-track]')!;
    const slides = [...car.querySelectorAll<HTMLElement>('[data-slide]')];
    const dots = [...car.querySelectorAll<HTMLButtonElement>('[data-dot]')];
    if (!slides.length) continue;

    const irA = (i: number) => {
      const n = (i + slides.length) % slides.length;
      track.scrollTo({ left: slides[n].offsetLeft - track.offsetLeft, behavior: 'smooth' });
    };
    const actual = () => {
      // La slide cuyo inicio está más cerca del scroll actual.
      let mejor = 0;
      let min = Infinity;
      slides.forEach((s, i) => {
        const d = Math.abs(s.offsetLeft - track.offsetLeft - track.scrollLeft);
        if (d < min) ((min = d), (mejor = i));
      });
      return mejor;
    };

    car.querySelector('[data-prev]')!.addEventListener('click', () => irA(actual() - 1));
    car.querySelector('[data-next]')!.addEventListener('click', () => irA(actual() + 1));
    dots.forEach((d, i) => d.addEventListener('click', () => irA(i)));

    const pintarDots = () => {
      const a = actual();
      dots.forEach((d, i) => (i === a ? d.setAttribute('aria-current', 'true') : d.removeAttribute('aria-current')));
    };
    track.addEventListener('scroll', () => requestAnimationFrame(pintarDots), { passive: true });
    pintarDots();

    // Auto-avance; se pausa al interactuar (hover/touch/foco) para no molestar.
    let timer = setInterval(() => irA(actual() + 1), 6000);
    const parar = () => clearInterval(timer);
    const seguir = () => {
      parar();
      timer = setInterval(() => irA(actual() + 1), 6000);
    };
    car.addEventListener('pointerenter', parar);
    car.addEventListener('pointerleave', seguir);
    car.addEventListener('focusin', parar);
    track.addEventListener('touchstart', parar, { passive: true });
  }
</script>
