---
import { IDIOMA_BASE, idiomaDeRuta, ruta, t } from '@/lib/i18n';

const idioma = idiomaDeRuta(Astro.url.pathname);
const dic = t(idioma);
const anio = new Date().getFullYear();
---

<footer class="border-t border-base-300/40 dark:border-base-700/40 mt-12">
  <div class="max-w-6xl mx-auto px-4 sm:px-6 py-8 text-sm text-base-500 flex flex-col sm:flex-row gap-3 justify-between">
    <p>
      © {anio} ManhwaToNovel · {dic.piePie}
      <span class="block mt-1 text-xs text-base-400">
        Índice de obras: no alojamos ni almacenamos contenido.
        <a class="hover:text-acento-500 transition-colors underline" href="/aviso-legal">Aviso legal y DMCA</a>
      </span>
    </p>
    <nav class="flex flex-wrap gap-x-4 gap-y-2">
      <a class="hover:text-acento-500 transition-colors" href={ruta(idioma, '/novelas')}>{dic.navCatalogo}</a>
      <a class="hover:text-acento-500 transition-colors" href={ruta(idioma, '/biblioteca')}>{dic.navBiblioteca}</a>
      {/* Novedades y Rankings existen SOLO en español (como el resto del
          catálogo, ver idiomasDeObra), así que la etiqueta va en español y el
          enlace lo declara con hreflang. Se enlazan desde todos los idiomas a
          propósito: son las dos páginas nuevas y sin enlaces internos serían
          huérfanas, que es justo lo que se quería arreglar. */}
      <a class="hover:text-acento-500 transition-colors" href={ruta(IDIOMA_BASE, '/novedades')} hreflang="es">
        Novedades
      </a>
      <a class="hover:text-acento-500 transition-colors" href={ruta(IDIOMA_BASE, '/rankings')} hreflang="es">
        Rankings
      </a>
      <a class="hover:text-acento-500 transition-colors" href={ruta(IDIOMA_BASE, '/titulos/a')} hreflang="es">
        Títulos A-Z
      </a>
      <a class="hover:text-acento-500 transition-colors" href="/rss.xml">RSS</a>
      <a class="hover:text-acento-500 transition-colors" href="/sitemap-index.xml">{dic.navSitemap}</a>
    </nav>
  </div>
</footer>
