---
import { idiomaDeRuta, ruta, t } from '@/lib/i18n';

const idioma = idiomaDeRuta(Astro.url.pathname);
const dic = t(idioma);
const anio = new Date().getFullYear();
---

<footer class="border-t border-base-300/40 dark:border-base-700/40 mt-12">
  <div class="max-w-6xl mx-auto px-4 sm:px-6 py-8 text-sm text-base-500 flex flex-col sm:flex-row gap-3 justify-between">
    <p>© {anio} ManhwaToNovel · {dic.piePie}</p>
    <nav class="flex gap-4">
      <a class="hover:text-acento-500 transition-colors" href={ruta(idioma, '/novelas')}>{dic.navCatalogo}</a>
      <a class="hover:text-acento-500 transition-colors" href={ruta(idioma, '/biblioteca')}>{dic.navBiblioteca}</a>
      <a class="hover:text-acento-500 transition-colors" href="/sitemap-index.xml">{dic.navSitemap}</a>
    </nav>
  </div>
</footer>
