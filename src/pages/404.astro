---
import Base from '@/layouts/Base.astro';
import { IDIOMA_BASE, ruta, t } from '@/lib/i18n';

/**
 * ─────────────────────────────────────────────────────────────────────────────
 * 404
 * ─────────────────────────────────────────────────────────────────────────────
 * Sin este archivo, Cloudflare Pages devolvía la PORTADA con un 200 en
 * cualquier ruta muerta —comprobado: /esto-no-existe-12345.txt respondía 200 y
 * 4,4 MB de HTML—. Eso es un soft 404: Google se lo come como página real, la
 * marca como duplicado de la portada y se gasta el rastreo en URLs que no
 * existen. Con `dist/404.html`, Pages responde 404 de verdad.
 *
 * Importa más de lo que parece en un agregador: las fuentes cambian de slug
 * (Olympus lo hace a diario) y el catálogo tiene miles de URLs. Las rutas
 * muertas son inevitables; lo que no puede ser es que respondan 200.
 *
 * Fuera de `[...idioma]` a propósito: Cloudflare busca UN `404.html` en la raíz.
 * Y ligera de peso: es la página que se sirve en todo lo que no existe.
 */
const idioma = IDIOMA_BASE;
const dic = t(idioma);

const salidas = [
  { href: ruta(idioma, '/novelas'), titulo: dic.navCatalogo, sub: 'Todo el catálogo, de la A a la Z' },
  { href: ruta(idioma, '/rankings'), titulo: 'Rankings', sub: 'Dónde la novela va más adelantada' },
  { href: ruta(idioma, '/novedades'), titulo: 'Novedades', sub: 'Lo que recibió capítulo nuevo' },
  { href: ruta(idioma, '/titulos/a'), titulo: 'Títulos A-Z', sub: 'Busca la obra por otro de sus nombres' },
];
---

<Base
  titulo="Esta página no existe · ManhwaToNovel"
  descripcion="La página que buscas no está aquí. Vuelve al catálogo de manhwas y novelas ligeras."
  noindex
>
  <section class="py-10 sm:py-16 text-center">
    <p class="text-5xl font-bold tabular-nums text-base-300 dark:text-base-600">404</p>
    <h1 class="mt-3 text-2xl sm:text-3xl font-bold tracking-tight text-base-800 dark:text-base-50">
      Esta página no existe
    </h1>
    <p class="mt-3 text-base-500 max-w-lg mx-auto text-pretty">
      Puede que la obra cambiara de dirección o que el enlace venga con una errata.
      El catálogo entero sigue aquí.
    </p>

    <nav class="mt-8 grid grid-cols-1 sm:grid-cols-2 gap-3 max-w-2xl mx-auto text-left">
      {salidas.map((s) => (
        <a
          href={s.href}
          class="neu-sm neu-press rounded-2xl p-4 transition-transform duration-200 hover:-translate-y-0.5"
        >
          <span class="block font-medium text-base-700 dark:text-base-200">{s.titulo}</span>
          <span class="block mt-0.5 text-sm text-base-400">{s.sub}</span>
        </a>
      ))}
    </nav>
  </section>
</Base>
