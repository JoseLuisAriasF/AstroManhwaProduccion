---
import Base from '@/layouts/Base.astro';
import NovelaCard from '@/components/NovelaCard.astro';
import { formatos, getCapitulosExternos, getNovelas } from '@/lib/api';
import { IDIOMA_BASE, idiomaDeRuta, ruta, t } from '@/lib/i18n';
import { idiomasDeObra, paramsDeIdioma } from '@/lib/publicables';
import { totalPaginas } from '@/lib/catalogo';
import { generosDestacados } from '@/lib/categorias';

export function getStaticPaths() {
  return paramsDeIdioma().map(({ idioma }) => ({ params: { idioma } }));
}

const idioma = idiomaDeRuta(Astro.url.pathname);
const dic = t(idioma);

// La ficha en el idioma donde existe (el catálogo va solo en `es`).
const fichaHref = (n: { slug: string; sinopsis?: string }) =>
  ruta(idiomasDeObra(n).includes(idioma) ? idioma : IDIOMA_BASE, `/novela/${n.slug}`);

const novelas = await getNovelas(idioma);
const obras = await Promise.all(
  novelas.map(async (n) => {
    const fmts = formatos(await getCapitulosExternos(n.slug));
    const tags = (fmts.length ? fmts : n.tipo === 'ambos' ? ['manhwa', 'novela'] : [n.tipo]) as (
      | 'manhwa'
      | 'novela'
    )[];
    return {
      novela: n,
      formatos: tags,
      ambos: fmts.length === 2,
      total: fmts.length, // proxy de completitud, solo para ordenar
      href: fichaHref(n),
      // Texto de búsqueda: título + alternos (para hallar por el nombre en inglés).
      q: [n.titulo, ...n.titulosAlternativos].join(' ').toLowerCase(),
    };
  }),
);

// Doble formato primero (el gancho), luego por más fuentes.
obras.sort((a, b) => Number(b.ambos) - Number(a.ambos) || b.total - a.total);

const destacadas = obras.filter((o) => o.ambos);
const paginas = totalPaginas(obras.length);
const generos = idioma === IDIOMA_BASE ? await generosDestacados(12) : [];

// Índice ligero para la búsqueda del lado del cliente: solo lo que pinta una
// tarjeta de resultado. Renderizar las 8.600 en HTML pesaba 10 MB y arrastraba
// el navegador; esto es texto, gzipea bien y el DOM inicial queda diminuto.
const indice = obras.map((o) => ({
  q: o.q,
  titulo: o.novela.titulo,
  alt: o.novela.titulosAlternativos[0] ?? '',
  portada: o.novela.portadaUrl,
  fmt: o.formatos,
  href: o.href,
}));
---

<Base titulo={`${dic.catalogo} · ManhwaToNovel`} descripcion={dic.seoCatalogoDesc} anchoCompleto>
  <h1 class="text-2xl font-bold tracking-tight text-base-800 dark:text-base-50">{dic.catalogo}</h1>
  <p class="mt-1 text-sm text-base-500" data-sub>
    {destacadas.length} obras con <strong class="text-acento-500">manhwa y novela</strong>. Busca un título para ver el catálogo completo.
  </p>

  <label class="mt-5 neu-inset rounded-xl flex items-center gap-3 px-4 py-3">
    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" class="size-5 text-base-400 shrink-0">
      <circle cx="11" cy="11" r="7" /><path d="m20 20-4-4" stroke-linecap="round" />
    </svg>
    <input
      id="buscador"
      type="search"
      placeholder="Buscar por título…"
      aria-label="Buscar novela"
      autocomplete="off"
      class="w-full bg-transparent outline-none text-base-800 dark:text-base-100 placeholder:text-base-400"
    />
  </label>

  {/* Grid por defecto: solo las de doble formato, renderizadas en el servidor. */}
  <div id="destacadas" class="mt-6 grid grid-cols-1 sm:grid-cols-2 gap-4">
    {destacadas.map(({ novela, formatos }) => (
      <NovelaCard novela={novela} formatos={formatos} />
    ))}
  </div>

  {/* Grid de resultados de búsqueda: se llena desde el índice al escribir. */}
  <div id="resultados" hidden class="mt-6 grid grid-cols-1 sm:grid-cols-2 gap-4"></div>

  <p id="sin-resultados" hidden class="mt-8 neu-inset rounded-2xl p-8 text-center text-base-500">
    No hay resultados. Prueba otro título.
  </p>

  {/* Géneros: hubs indexables que capturan búsquedas de alto volumen y enlazan
      hacia el catálogo. */}
  {generos.length > 0 && (
    <nav class="mt-10" aria-label="Géneros">
      <h2 class="font-semibold text-base-800 dark:text-base-100">Explora por género</h2>
      <div class="mt-3 flex flex-wrap gap-2">
        {generos.map((g) => (
          <a href={ruta(idioma, `/categoria/${g.slug}`)} class="neu-sm neu-press rounded-xl px-3 py-1.5 text-sm">
            {g.nombre} <span class="text-base-400 tabular-nums">{g.obras.length}</span>
          </a>
        ))}
      </div>
    </nav>
  )}

  {/* Entrada al catálogo completo paginado. Es lo que da a las ~6.400 fichas
      restantes un camino que el buscador puede recorrer: sin estos enlaces son
      páginas huérfanas y Google no las indexa por mucho sitemap que haya. */}
  {idioma === IDIOMA_BASE && paginas > 1 && (
    <nav class="mt-10 border-t border-base-300/40 dark:border-base-700/40 pt-6" aria-label="Catálogo completo">
      <h2 class="font-semibold text-base-800 dark:text-base-100">Todo el catálogo</h2>
      <p class="mt-1 text-sm text-base-500">{obras.length} obras, de la A a la Z.</p>
      <div class="mt-3 flex flex-wrap gap-2">
        {[...Array(Math.min(paginas, 12))].map((_, i) => (
          <a href={ruta(idioma, `/novelas/${i + 2}`)} class="neu-sm neu-press rounded-xl px-3 py-1.5 text-sm tabular-nums">
            {i + 1}
          </a>
        ))}
        {paginas > 12 && (
          <a href={ruta(idioma, `/novelas/${paginas + 1}`)} class="neu-sm neu-press rounded-xl px-3 py-1.5 text-sm tabular-nums">
            … {paginas}
          </a>
        )}
      </div>
    </nav>
  )}

  <script is:inline define:vars={{ indice }}>
    window.__indice = indice;
  </script>
</Base>

<script>
  type Item = { q: string; titulo: string; alt: string; portada: string; fmt: string[]; href: string };
  const indice: Item[] = (window as any).__indice ?? [];

  const input = document.getElementById('buscador') as HTMLInputElement;
  const destacadas = document.getElementById('destacadas') as HTMLElement;
  const resultados = document.getElementById('resultados') as HTMLElement;
  const sub = document.querySelector<HTMLElement>('[data-sub]');
  const vacio = document.getElementById('sin-resultados') as HTMLElement;

  const esc = (s: string) =>
    s.replace(/[&<>"]/g, (c) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;' })[c]!);

  const tarjeta = (it: Item) => {
    const tags = it.fmt
      .map(
        (f) =>
          `<span class="rounded-lg px-2 py-0.5 neu-inset capitalize ${f === 'manhwa' ? 'text-emerald-500' : 'text-acento-500'}">${f}</span>`,
      )
      .join('');
    return `<article class="neu rounded-2xl overflow-hidden flex gap-4 p-3">
      <a href="${it.href}" class="shrink-0">
        <img src="${esc(it.portada)}" alt="${esc(it.titulo)}" width="112" height="160" loading="lazy" decoding="async"
             class="w-20 sm:w-28 aspect-[7/10] object-cover rounded-xl neu-sm" />
      </a>
      <div class="min-w-0 flex flex-col py-1">
        <div class="flex items-center gap-2 text-[11px] font-medium">${tags}</div>
        <h3 class="mt-1.5 font-semibold leading-snug text-base-800 dark:text-base-100">
          <a href="${it.href}" class="hover:text-acento-500 transition-colors">${esc(it.titulo)}</a>
        </h3>
        <p class="text-xs text-base-400 truncate">${esc(it.alt)}</p>
      </div>
    </article>`;
  };

  input.addEventListener('input', () => {
    const q = input.value.trim().toLowerCase();
    if (q === '') {
      // Sin búsqueda: vuelve el default (solo doble formato).
      resultados.hidden = true;
      resultados.innerHTML = '';
      destacadas.hidden = false;
      if (sub) sub.hidden = false;
      vacio.hidden = true;
      return;
    }
    // Con búsqueda: se abre a todo el catálogo. Se cortan a 60 para no inundar el DOM.
    const hits = indice.filter((it) => it.q.includes(q)).slice(0, 60);
    destacadas.hidden = true;
    if (sub) sub.hidden = true;
    resultados.innerHTML = hits.map(tarjeta).join('');
    resultados.hidden = hits.length === 0;
    vacio.hidden = hits.length > 0;
  });
</script>
