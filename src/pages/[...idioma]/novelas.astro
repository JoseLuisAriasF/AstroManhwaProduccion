---
import Base from '@/layouts/Base.astro';
import NovelaCard from '@/components/NovelaCard.astro';
import { formatos, getCapitulos, getCapitulosExternos, getNovelas } from '@/lib/api';
import { idiomaDeRuta, t } from '@/lib/i18n';
import { paramsDeIdioma } from '@/lib/publicables';

export function getStaticPaths() {
  return paramsDeIdioma().map(({ idioma }) => ({ params: { idioma } }));
}

const idioma = idiomaDeRuta(Astro.url.pathname);
const dic = t(idioma);

const novelas = await getNovelas(idioma);
const conTotales = await Promise.all(
  novelas.map(async (n) => {
    const [caps, externos] = await Promise.all([getCapitulos(n.slug), getCapitulosExternos(n.slug)]);
    const fmts = formatos(externos);
    // El gancho del sitio: tiene manhwa Y novela. El campo `tipo` no sirve (casi
    // nunca marca 'ambos'); la señal fiable es tener capítulos de los dos formatos.
    return { novela: n, total: caps.length, formatos: fmts, ambos: fmts.length === 2 };
  }),
);

// Las de doble formato primero (es a lo que se viene); dentro, las más largas.
conTotales.sort((a, b) => Number(b.ambos) - Number(a.ambos) || b.total - a.total);

const categorias = [...new Set(novelas.flatMap((n) => n.categorias))].sort();
const conDoble = conTotales.filter((n) => n.ambos).length;

// Texto para la búsqueda: título + títulos alternativos (para encontrar por el
// nombre en inglés/coreano aunque la ficha esté en español).
const buscable = (n: { titulo: string; titulosAlternativos: string[] }) =>
  [n.titulo, ...n.titulosAlternativos].join(' ').toLowerCase();
---

<Base titulo={`${dic.catalogo} · ManhwaToNovel`} descripcion={dic.seoCatalogoDesc} anchoCompleto>
  <h1 class="text-2xl font-bold tracking-tight text-base-800 dark:text-base-50">{dic.catalogo}</h1>
  <p class="mt-1 text-sm text-base-500" data-sub>
    {conDoble} obras con <strong class="text-acento-500">manhwa y novela</strong>. Busca un título para ver el catálogo completo.
  </p>

  <label class="mt-5 neu-inset rounded-xl flex items-center gap-3 px-4 py-3">
    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" class="size-5 text-base-400 shrink-0">
      <circle cx="11" cy="11" r="7" /><path d="m20 20-4-4" stroke-linecap="round" />
    </svg>
    <input
      id="buscador"
      type="search"
      placeholder="Buscar por título…"
      aria-label="Buscar novela"
      autocomplete="off"
      class="w-full bg-transparent outline-none text-base-800 dark:text-base-100 placeholder:text-base-400"
    />
  </label>

  <div class="mt-4 flex flex-wrap gap-2" data-filtros>
    <button data-cat="" class="neu-sm neu-press rounded-xl px-3 py-1.5 text-sm aria-pressed:text-acento-500" aria-pressed="true">
      {dic.todas}
    </button>
    {
      categorias.map((c) => (
        <button data-cat={c} class="neu-sm neu-press rounded-xl px-3 py-1.5 text-sm aria-pressed:text-acento-500" aria-pressed="false">
          {c}
        </button>
      ))
    }
  </div>

  <div class="mt-6 grid sm:grid-cols-2 gap-4">
    {
      conTotales.map(({ novela, total, formatos, ambos }) => (
        <div
          data-cats={novela.categorias.join('|')}
          data-ambos={ambos ? '1' : ''}
          data-titulo={buscable(novela)}
          hidden={!ambos}
        >
          <NovelaCard novela={novela} totalCapitulos={total} formatos={formatos} />
        </div>
      ))
    }
  </div>

  <p id="sin-resultados" hidden class="mt-8 neu-inset rounded-2xl p-8 text-center text-base-500">
    No hay resultados. Prueba otro título.
  </p>
</Base>

<script>
  const input = document.getElementById('buscador') as HTMLInputElement;
  const botones = document.querySelectorAll<HTMLButtonElement>('[data-cat]');
  const tarjetas = [...document.querySelectorAll<HTMLElement>('[data-cats]')];
  const sub = document.querySelector<HTMLElement>('[data-sub]');
  const vacio = document.getElementById('sin-resultados') as HTMLElement;

  let cat = '';

  const aplicar = () => {
    const q = input.value.trim().toLowerCase();
    // Sin búsqueda ni categoría, el catálogo muestra SOLO las de doble formato
    // (el gancho); en cuanto se busca o se filtra por categoría, se abre a todo.
    const abierto = q !== '' || cat !== '';
    let visibles = 0;
    tarjetas.forEach((t) => {
      const okCat = cat === '' || t.dataset.cats!.split('|').includes(cat);
      const okQ = q === '' || t.dataset.titulo!.includes(q);
      const okBase = abierto || t.dataset.ambos === '1';
      const ver = okCat && okQ && okBase;
      t.hidden = !ver;
      if (ver) visibles++;
    });
    if (sub) sub.hidden = abierto; // el subtítulo explica el modo por defecto
    vacio.hidden = visibles > 0;
  };

  input.addEventListener('input', aplicar);
  botones.forEach((b) =>
    b.addEventListener('click', () => {
      cat = b.dataset.cat!;
      botones.forEach((o) => o.setAttribute('aria-pressed', String(o === b)));
      aplicar();
    }),
  );
</script>
