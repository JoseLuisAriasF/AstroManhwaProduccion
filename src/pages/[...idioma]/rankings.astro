---
import Base from '@/layouts/Base.astro';
import { getCapitulosExternos, getNovelas } from '@/lib/api';
import { brechaDe, type Brecha } from '@/lib/brecha';
import { IDIOMA_BASE, idiomaDeRuta, ruta, t } from '@/lib/i18n';
import { PUBLICADOS, idiomasDeObra, paramsDeIdioma } from '@/lib/publicables';
import { migas } from '@/lib/seo';
import type { Novela } from '@/types/novela';

/**
 * ─────────────────────────────────────────────────────────────────────────────
 * RANKINGS: listas que solo este sitio puede hacer
 * ─────────────────────────────────────────────────────────────────────────────
 * "Los manhwas cuya novela va más adelantada" no lo puede publicar una scan
 * (solo ve su propio catálogo) ni una base de fichas (no indexa capítulos). Sale
 * de cruzar las dos cosas, que es justo lo que hay en `capitulos_externos`.
 *
 * Una lista ordenada es además el tipo de página que la gente enlaza y comparte
 * —a una ficha suelta no se enlaza—, y aquí sale de un cálculo, no de escribir.
 *
 * En español e inglés («manhwa where the novel is ahead» se busca en inglés).
 * Las filas enlazan a la ficha en el idioma en que exista.
 */
export function getStaticPaths() {
  return paramsDeIdioma().map(({ idioma }) => ({ params: { idioma } }));
}

const idioma = idiomaDeRuta(Astro.url.pathname);
const dic = t(idioma);
const en = idioma === 'en';
const T = en
  ? {
      titulo: 'Manhwa where the novel is ahead — Rankings · ManhwaToNovel',
      desc: (n: number) => `Which manhwa have the novel far ahead, which are caught up, and the longest novels. ${n} series with both formats indexed.`,
      intro: (n: number) => `The most popular series and, by matching manhwa chapters with their novel, lists you will not find anywhere else. ${n} series have both formats indexed.`,
      vacio: 'Nothing indexed yet. Series will show up as the indexer runs.',
      capsIndexados: 'chapters indexed',
      capsNovela: 'novel chapters',
      alDia: 'caught up',
      detalle: (m: number, n: number) => `manhwa ${m} · novel ${n}`,
      listas: [
        ['Most popular', 'By scanlation volume: the more sources and chapters a series has, the more people follow it.'],
        ['The novel is ahead of the manhwa', 'You finished the manhwa and the story goes on. This is where it goes on the most.'],
        ['The manhwa caught up with the novel', 'You are not missing anything here: they are neck and neck.'],
        ['Longest novels', 'By chapters indexed. Reading for months.'],
      ],
      secciones: 'Sections',
    }
  : {
      titulo: 'Manhwas cuya novela va más adelantada — Rankings · ManhwaToNovel',
      desc: (n: number) => `Qué manhwas tienen la novela mucho más avanzada, cuáles ya están al día y las novelas más largas. ${n} obras con los dos formatos indexados.`,
      intro: (n: number) => `Las obras más populares y, cruzando los capítulos del manhwa con los de su novela, listas que no existen en ningún otro sitio. ${n} obras tienen los dos formatos indexados.`,
      vacio: 'Todavía no hay obras indexadas. Aparecerán solas conforme corra el indexador.',
      capsIndexados: 'capítulos indexados',
      capsNovela: 'capítulos de novela',
      alDia: 'al día',
      detalle: (m: number, n: number) => `manhwa ${m} · novela ${n}`,
      listas: [
        ['Las más populares', 'Por volumen de scanlation: cuantas más fuentes y capítulos tiene una obra, más gente la sigue.'],
        ['La novela va más adelantada que el manhwa', 'Terminaste el manhwa y la historia sigue. Aquí es donde más sigue.'],
        ['El manhwa ya alcanzó a la novela', 'Aquí no te estás perdiendo nada: van a la par.'],
        ['Las novelas más largas', 'Por capítulos indexados. Para leer durante meses.'],
      ],
      secciones: 'Secciones',
    };
const fichaDe = (n: Novela) => ruta(idiomasDeObra(n).includes(idioma) ? idioma : IDIOMA_BASE, `/novela/${n.slug}`);

interface Fila {
  novela: Novela;
  brecha: Brecha;
}

// Cada fila ya trae su número y su detalle en texto: así las cuatro listas —tres
// de brecha y una de popularidad— comparten el mismo render sin ramas.
interface FilaRender {
  novela: Novela;
  valor: string;
  detalle: string;
}

const novelas = await getNovelas(idioma);
const filas: Fila[] = [];
// Popularidad: nº de capítulos indexados de TODA la obra (manhwa + novela). Es
// el mejor proxy disponible sin datos de vistas —cuantas más fuentes y
// capítulos tiene una obra, más scanlation recibe, o sea más gente la sigue—.
const populares: { novela: Novela; caps: number }[] = [];
for (const novela of novelas) {
  const externos = await getCapitulosExternos(novela.slug);
  if (externos.length) populares.push({ novela, caps: externos.length });
  const brecha = brechaDe(externos);
  if (brecha) filas.push({ novela, brecha });
}

const TOPE = 50;
const mil = (n: number) => n.toLocaleString(idioma);

// Las más populares: por volumen de scanlation. Va primera porque es la lista
// que la gente busca ("los más vistos") y la que engancha en frío.
const masPopulares: FilaRender[] = [...populares]
  .sort((a, b) => b.caps - a.caps)
  .slice(0, TOPE)
  .map((p) => ({ novela: p.novela, valor: mil(p.caps), detalle: T.capsIndexados }));

// El gancho del sitio, ordenado: dónde hay más historia esperando.
const masAdelantadas: FilaRender[] = [...filas]
  .sort((a, b) => b.brecha.faltan - a.brecha.faltan)
  .slice(0, TOPE)
  .map((f) => ({ novela: f.novela, valor: `+${f.brecha.faltan}`, detalle: T.detalle(f.brecha.manhwa, f.brecha.novela) }));
// Lo contrario, que también se busca: el manhwa ya alcanzó (o casi) a la novela.
const alDia: FilaRender[] = filas
  .filter((f) => f.brecha.faltan <= 5)
  .sort((a, b) => a.brecha.faltan - b.brecha.faltan || b.brecha.manhwa - a.brecha.manhwa)
  .slice(0, TOPE)
  .map((f) => ({ novela: f.novela, valor: f.brecha.faltan === 0 ? T.alDia : `+${f.brecha.faltan}`, detalle: T.detalle(f.brecha.manhwa, f.brecha.novela) }));
// Las novelas más largas indexadas: "novelas con más capítulos" es una consulta
// con volumen propio y esta es la respuesta real, no una lista a ojo.
const masLargas: FilaRender[] = [...filas]
  .sort((a, b) => b.brecha.novela - a.brecha.novela)
  .slice(0, TOPE)
  .map((f) => ({ novela: f.novela, valor: `${f.brecha.novela}`, detalle: T.capsNovela }));

const listas = [
  {
    id: 'mas-populares',
    titulo: T.listas[0][0],
    sub: T.listas[0][1],
    filas: masPopulares,
  },
  {
    id: 'mas-adelantadas',
    titulo: T.listas[1][0],
    sub: T.listas[1][1],
    filas: masAdelantadas,
  },
  {
    id: 'al-dia',
    titulo: T.listas[2][0],
    sub: T.listas[2][1],
    filas: alDia,
  },
  {
    id: 'mas-largas',
    titulo: T.listas[3][0],
    sub: T.listas[3][1],
    filas: masLargas,
  },
];

const jsonLd = listas.map((l) => ({
  '@context': 'https://schema.org',
  '@type': 'ItemList',
  name: l.titulo,
  numberOfItems: l.filas.length,
  itemListElement: l.filas.slice(0, 10).map((f, i) => ({
    '@type': 'ListItem',
    position: i + 1,
    name: f.novela.titulo,
    url: new URL(fichaDe(f.novela), Astro.site).toString(),
  })),
}));

const ruta_migas = migas(Astro.site, [
  { nombre: dic.navInicio, href: ruta(idioma) },
  { nombre: 'Rankings', href: ruta(idioma, '/rankings') },
]);

---

<Base
  titulo={T.titulo}
  descripcion={T.desc(filas.length)}
  anchoCompleto
  jsonLd={[...jsonLd, ruta_migas]}
  idiomas={PUBLICADOS}
>
  <nav class="text-sm text-base-400 mb-4" aria-label="breadcrumb">
    <a href={ruta(idioma)} class="hover:text-acento-500">{dic.navInicio}</a>
    <span class="mx-1.5">/</span>
    <span class="text-base-500">Rankings</span>
  </nav>

  <h1 class="text-2xl sm:text-3xl font-bold tracking-tight text-base-800 dark:text-base-50">
    Rankings
  </h1>
  <p class="mt-2 text-base-500 max-w-2xl">{T.intro(filas.length)}</p>

  {masPopulares.length === 0 && (
    <p class="mt-8 neu-inset rounded-2xl p-5 text-base-500">{T.vacio}</p>
  )}

  {/* Índice de la propia página: en móvil, varias listas de 50 son mucho scroll. */}
  {masPopulares.length > 0 && (
    <nav class="mt-5 flex flex-wrap gap-2" aria-label={T.secciones}>
      {listas.map((l) => (
        <a href={`#${l.id}`} class="text-sm neu-inset neu-press rounded-lg px-3 py-1.5 hover:text-acento-500">
          {l.titulo}
        </a>
      ))}
    </nav>
  )}

  {listas.filter((l) => l.filas.length > 0).map((l) => (
    <section id={l.id} class="mt-10 scroll-mt-24">
      <h2 class="text-xl font-bold text-base-800 dark:text-base-50">{l.titulo}</h2>
      <p class="mt-1 text-sm text-base-500">{l.sub}</p>
      <ol class="mt-4 grid gap-2">
        {l.filas.map((f, i) => (
          <li>
            <a
              href={fichaDe(f.novela)}
              class="neu-sm rounded-xl p-3 flex items-center gap-3 transition-transform duration-200 hover:-translate-y-0.5"
            >
              <span class="w-7 shrink-0 text-center text-sm font-semibold tabular-nums text-base-400">
                {i + 1}
              </span>
              <img
                src={f.novela.portadaUrl}
                data-fb={JSON.stringify((f.novela.portadas ?? []).filter((u) => u !== f.novela.portadaUrl))}
                alt=""
                width="36"
                height="51"
                loading="lazy"
                decoding="async"
                class="w-9 aspect-[7/10] object-cover rounded-lg shrink-0"
              />
              <span class="min-w-0 flex-1">
                <span class="block text-sm font-medium text-base-700 dark:text-base-200 line-clamp-1">
                  {f.novela.titulo}
                </span>
                <span class="block text-[11px] text-base-400 tabular-nums">{f.detalle}</span>
              </span>
              <span class="shrink-0 text-sm font-semibold tabular-nums text-acento-500">
                {f.valor}
              </span>
            </a>
          </li>
        ))}
      </ol>
    </section>
  ))}
</Base>
