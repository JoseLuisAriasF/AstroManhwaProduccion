---
import Base from '@/layouts/Base.astro';
import ManhwaToNovelBridge from '@/components/ManhwaToNovelBridge.astro';
import ListaCapitulos from '@/components/ListaCapitulos.astro';
import CapitulosExternos from '@/components/CapitulosExternos.astro';
import SyncExplanationBanner from '@/components/SyncExplanationBanner.astro';
import { formatos, fuentesDe, getCapitulos, getCapitulosExternos, getEquivalencias, getNovelas } from '@/lib/api';
import { IDIOMA_BASE, IDIOMAS, idiomaDeRuta, ruta, t } from '@/lib/i18n';
import { idiomasDeObra, paramsDeIdioma } from '@/lib/publicables';
import { relacionadasDe } from '@/lib/catalogo';
import { slugCategoria } from '@/lib/categorias';
import { faq, migas, type Pregunta } from '@/lib/seo';
import { brechaDe } from '@/lib/brecha';

export async function getStaticPaths() {
  const novelas = await getNovelas();
  // El catálogo sin prosa traducida se publica solo en `es` (ver idiomasDeObra):
  // sin esto serían 8.600 obras × 7 idiomas y el build no cabe en el tiempo de CF.
  const paramDe = new Map(paramsDeIdioma().map((p) => [p.codigo, p.idioma]));
  return novelas.flatMap((novela) =>
    idiomasDeObra(novela)
      .filter((c) => paramDe.has(c))
      .map((codigo) => ({ params: { idioma: paramDe.get(codigo), slug: novela.slug } })),
  );
}

const idioma = idiomaDeRuta(Astro.url.pathname);
const dic = t(idioma);
const { slug } = Astro.params;

const novelas = await getNovelas(idioma);
const novela = novelas.find((n) => n.slug === slug)!;
const capitulos = await getCapitulos(novela.slug, idioma);
const externos = await getCapitulosExternos(novela.slug);
// Agrupados POR SCAN (estilo zonascans): cada fuente es su tarjeta, ordenadas
// por número de capítulos. Y qué formatos hay, para el aviso "Manhwa · Novela".
const fuentes = fuentesDe(externos);
const formatosDisponibles = formatos(externos);
const anclas = await getEquivalencias(novela.slug);
// El puente se muestra si la obra tiene manhwa Y novela (aunque no haya anclas:
// la comunidad puede aportar/votar la primera).
const tieneAmbos = formatosDisponibles.length === 2;
// Sin capítulos internos, la novela vive fuera: oculto el lector propio,
// el sync, el puente manhwa↔novela y el CTA de "empezar a leer" (rompería
// en /capitulo-1). La página muestra la ficha + los enlaces externos.
const hayLecturaInterna = capitulos.length > 0;

const base = ruta(idioma, `/novela/${novela.slug}`);
const url = new URL(base, Astro.site).toString();

// Cómo la busca la gente: el título en inglés suele ser la consulta más común
// fuera de Latinoamérica, así que va también en el <title>.
const [tituloIngles] = novela.titulosAlternativos;
const relacionadas = await relacionadasDe(novela);

const alternos = novela.titulosAlternativos.join(', ');

// La brecha manhwa↔novela: el número por el que la gente llega. Si existe, se
// pinta arriba y se le da su propia página (/equivalencia), que es la que pelea
// la consulta "¿por qué capítulo sigo?".
const brecha = brechaDe(externos);

// ── El <title>, con los números que se buscan ────────────────────────────────
// Un capítulo suelto se busca por su número —"<obra> cap 1200", "<obra> manhwa
// 1200", "<obra> novel 1200"— y el grueso de esas búsquedas es por el ÚLTIMO
// publicado. El <title> es la señal más fuerte de la página, así que lleva el
// último de cada formato: se actualiza solo cada noche con el scrapeo, y de paso
// mete las palabras "manhwa" y "novela" y el nombre en inglés, que es como se
// busca la misma obra fuera de Latinoamérica.
const ultimoDe = (tipo: 'manhwa' | 'novela') =>
  Math.max(0, ...fuentes.filter((f) => f.tipo === tipo).map((f) => f.ultimo));
const ultimoManhwa = ultimoDe('manhwa');
const ultimoNovela = ultimoDe('novela');
const capsTitulo = [
  ultimoManhwa && `manhwa cap. ${ultimoManhwa}`,
  ultimoNovela && `novela cap. ${ultimoNovela}`,
]
  .filter(Boolean)
  .join(' · ');
const nombres = [novela.titulo, tituloIngles].filter((n, i, a) => n && a.indexOf(n) === i).join(' / ');

// Los últimos capítulos con página propia (la arma la función del edge, ver
// functions/novela/[slug]/[capitulo].ts). Son la ENTRADA a esa cadena: cada una
// enlaza a la anterior y a la siguiente, así que con estos pocos enlaces el
// rastreador puede recorrer los ~200.000 capítulos sin que la ficha se llene de
// enlaces. Sin ellos las páginas colgarían solo del sitemap, y una URL que no
// enlaza nadie se rastrea tarde y mal.
// Las fuentes link-out (Olympus) NO cuentan: guardan una fila con el total en
// `numero` y la URL de la serie. Ese número no es un capítulo que exista.
const ultimosNumeros = [
  ...new Set(
    fuentes
      .filter((f) => !f.soloEnlace)
      .flatMap((f) => f.capitulos.map((c) => c.numero))
      .filter((n): n is number => typeof n === 'number' && n > 0),
  ),
]
  .sort((a, b) => b - a)
  .slice(0, 6);
const tituloSeo =
  idioma === IDIOMA_BASE && capsTitulo
    ? `${nombres} — ${capsTitulo}`
    : dic.seoNovelaTitulo(novela.titulo, tituloIngles ?? novela.titulo);

// La descripción es lo que decide el clic en el resultado de Google, y un
// número concreto gana a cualquier adjetivo. Solo en español: es el idioma en
// que está escrita esta frase, y meterla en /en/ sería texto suelto en otro
// idioma. El resto de idiomas se queda con la del diccionario.
const descripcionSeo =
  idioma === IDIOMA_BASE && brecha?.faltan
    ? `El manhwa va por el capítulo ${brecha.manhwa} y la novela por el ${brecha.novela}: te faltan ${brecha.faltan} capítulos de historia. Te decimos por cuál seguir y dónde leerla.`
    : dic.seoNovelaDesc(novela.titulo, alternos, capitulos.length);


const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Book',
  '@id': url,
  name: novela.titulo,
  alternateName: novela.titulosAlternativos,
  url,
  description: novela.sinopsis,
  image: new URL(novela.portadaUrl, Astro.site).toString(),
  inLanguage: IDIOMAS[idioma].htmlLang,
  bookFormat: 'https://schema.org/EBook',
  genre: novela.categorias,
  numberOfPages: capitulos.length,
  author: { '@type': 'Organization', name: 'ManhwaToNovel' },
  potentialAction: {
    '@type': 'ReadAction',
    target: {
      '@type': 'EntryPoint',
      urlTemplate: `${url}/capitulo-1`,
      actionPlatform: [
        'https://schema.org/DesktopWebPlatform',
        'https://schema.org/MobileWebPlatform',
      ],
    },
  },
};

// Las mismas migas que se pintan abajo, marcadas para Google. Si el marcado y
// lo visible no coinciden, el rich result se descarta: por eso salen de aquí.
const ruta_migas = migas(Astro.site, [
  { nombre: dic.navInicio, href: ruta(idioma) },
  { nombre: dic.navNovelas, href: ruta(idioma, '/novelas') },
  { nombre: novela.titulo, href: base },
]);

// ── Texto propio para fichas "pobres" ────────────────────────────────────────
// Muchas fichas solo tienen enlaces externos y sin sinopsis son thin content:
// Google las rastrea y no las indexa. Esta intro las convierte en algo propio,
// SIN copiar nada de otro sitio —son datos nuestros: formatos, conteos, brecha—.
// Solo se pinta cuando NO hay sinopsis escrita (ver más abajo).
const formatoTexto =
  formatosDisponibles.length === 2
    ? 'manhwa y novela'
    : formatosDisponibles[0] ?? (novela.tipo === 'ambos' ? 'manhwa y novela' : novela.tipo);
const introGenerada = [
  `${novela.titulo}${tituloIngles && tituloIngles !== novela.titulo ? ` (${tituloIngles})` : ''} está disponible como ${formatoTexto}.`,
  fuentes.length
    ? `Está indexada en ${fuentes.length} ${fuentes.length === 1 ? 'fuente' : 'fuentes'}, cada una con enlace al sitio original.`
    : '',
  brecha
    ? `La novela va por el capítulo ${brecha.novela} y el manhwa por el ${brecha.manhwa}${brecha.faltan ? `: ${brecha.faltan} capítulos por delante` : ''}.`
    : '',
]
  .filter(Boolean)
  .join(' ');

// ── FAQ: solo preguntas que se pueden responder con datos ────────────────────
// El FAQPage del <head> repite estas mismas preguntas, que se pintan visibles
// más abajo. Marcado sin contenido visible es penalización, no atajo.
const nombresFuentes = [...new Set(fuentes.map((f) => f.nombre).filter(Boolean))];
const preguntas: Pregunta[] = [];
if (fuentes.length) {
  preguntas.push({
    pregunta: `¿Dónde leer ${novela.titulo}?`,
    respuesta: `Está indexada en ${fuentes.length} ${fuentes.length === 1 ? 'fuente' : 'fuentes'}${
      nombresFuentes.length ? ` (${nombresFuentes.slice(0, 5).join(', ')})` : ''
    }. Cada una enlaza al sitio original donde se lee gratis.`,
  });
}
if (brecha) {
  preguntas.push({
    pregunta: `¿Cuántos capítulos tiene ${novela.titulo}?`,
    respuesta: `El manhwa lleva ${brecha.manhwa} capítulos indexados y la novela ${brecha.novela}${
      brecha.faltan ? `, ${brecha.faltan} por delante del manhwa` : ''
    }.`,
  });
  preguntas.push({
    pregunta: `¿Puedo leer la novela de ${novela.titulo} sin spoilers del manhwa?`,
    respuesta: `Sí: empieza por el capítulo de la novela que corresponde a donde dejaste el manhwa. Lo que la novela te adelanta es lo que el manhwa aún no ha dibujado, no lo que ya leíste.`,
  });
}
if (novela.estado) {
  preguntas.push({
    pregunta: `¿${novela.titulo} está terminada?`,
    respuesta:
      novela.estado === 'Finalizado'
        ? `Sí, ${novela.titulo} está finalizada.`
        : `No, ${novela.titulo} sigue en emisión y recibe capítulos nuevos.`,
  });
}
// FAQPage solo si hay al menos dos (una sola no es una FAQ) y solo en el idioma
// base: las preguntas están escritas en español, y el schema DEBE coincidir con
// lo visible —que también es es-only—, o Google lo descarta por marcado engañoso.
const jsonLdFaq = preguntas.length >= 2 && idioma === IDIOMA_BASE ? [faq(preguntas)] : [];
---

<Base
  titulo={tituloSeo}
  descripcion={descripcionSeo}
  imagen={novela.portadaUrl}
  tipo="book"
  jsonLd={[jsonLd, ruta_migas, ...jsonLdFaq]}
  idiomas={idiomasDeObra(novela)}
>
  {/* La portada es el LCP de la ficha: precargarla adelanta la mayor pintura y
      mejora Core Web Vitals (además del fetchpriority del <img>). */}
  <link slot="head" rel="preload" as="image" href={novela.portadaUrl} fetchpriority="high" />

  <nav class="text-sm text-base-400 mb-5" aria-label="breadcrumb">
    <a href={ruta(idioma)} class="hover:text-acento-500">{dic.navInicio}</a>
    <span class="mx-1.5">/</span>
    <a href={ruta(idioma, '/novelas')} class="hover:text-acento-500">{dic.navNovelas}</a>
    <span class="mx-1.5">/</span>
    <span class="text-base-500">{novela.titulo}</span>
  </nav>

  <article class="neu rounded-2xl p-5 sm:p-6 flex flex-col sm:flex-row gap-6">
    <img
      src={novela.portadaUrl}
      data-fb={JSON.stringify((novela.portadas ?? []).filter((u) => u !== novela.portadaUrl))}
      alt={novela.titulo}
      width="224"
      height="320"
      fetchpriority="high"
      decoding="async"
      class="w-40 sm:w-56 self-center sm:self-start aspect-[7/10] object-cover rounded-2xl neu-sm"
    />

    <div class="min-w-0 flex-1">
      <div class="flex items-center gap-2 text-xs font-medium">
        <span
          class:list={[
            'neu-inset rounded-lg px-2 py-1',
            novela.estado === 'En emisión' ? 'text-emerald-500' : 'text-base-500',
          ]}>{novela.estado === 'En emisión' ? dic.enEmision : dic.finalizado}</span
        >
        {hayLecturaInterna && <span class="text-base-400 tabular-nums">{dic.nCapitulos(capitulos.length)}</span>}
        {/* Que se sepa de un vistazo si hay manhwa, novela o ambos. */}
        {formatosDisponibles.map((f) => (
          <span
            class:list={[
              'rounded-lg px-2 py-1 neu-inset capitalize',
              f === 'novela' ? 'text-acento-500' : 'text-emerald-500',
            ]}
          >
            {f}
          </span>
        ))}
      </div>

      {/* El nombre en inglés va DENTRO del h1: fuera de Latinoamérica es la
          consulta más común ("Return of the Mount Hua Sect"), y el h1 es la
          señal de relevancia más fuerte de la página después del <title>. */}
      <h1 class="mt-2 text-2xl sm:text-3xl font-bold tracking-tight text-base-800 dark:text-base-50 text-balance">
        {novela.titulo}
        {tituloIngles && tituloIngles !== novela.titulo && (
          <span class="block mt-1 text-base sm:text-lg font-medium text-base-500">{tituloIngles}</span>
        )}
      </h1>

      {/* Texto visible, no meta keywords: es lo que Google indexa de verdad. */}
      {novela.titulosAlternativos.length > 0 && (
        <div class="mt-2" data-expandible>
          {/* Todos los nombres están SIEMPRE en el HTML (Google los lee para que
              te encuentren por el título en inglés/coreano); el recorte es solo
              visual, con "ver más" para no comer pantalla en móvil. */}
          <p data-exp data-clamp="line-clamp-2" class="text-sm text-base-500 line-clamp-2">
            <span class="text-base-400">{dic.tambienConocida}</span>{' '}
            <span class="text-base-600 dark:text-base-300">
              {novela.titulosAlternativos.join(' · ')}
            </span>
          </p>
          <button hidden data-exp-btn data-mas={dic.verMas} data-menos={dic.verMenos} class="mt-0.5 text-xs font-medium text-acento-500">
            {dic.verMas}
          </button>
        </div>
      )}

      <div class="mt-3 flex flex-wrap gap-2">
        {
          novela.categorias.map((c) => (
            <a
              href={ruta(idioma, `/categoria/${slugCategoria(c)}`)}
              class="text-xs text-base-500 neu-inset neu-press rounded-lg px-2 py-1 hover:text-acento-500"
            >
              {c}
            </a>
          ))
        }
      </div>

      {novela.sinopsis && (
        <div class="mt-4" data-expandible>
          {/* Recortada a 6 líneas; el botón (que el script muestra solo si el
              texto rebasa) la despliega. En móvil una sinopsis larga comía media
              pantalla antes de ver los capítulos. */}
          <p
            data-exp
            data-clamp="line-clamp-6"
            class="text-base-600 dark:text-base-300 leading-relaxed text-pretty line-clamp-6"
          >
            {novela.sinopsis}
          </p>
          <button hidden data-exp-btn data-mas={dic.verMas} data-menos={dic.verMenos} class="mt-1 text-sm font-medium text-acento-500">
            {dic.verMas}
          </button>
        </div>
      )}

      {/* Sin sinopsis escrita: un párrafo propio con nuestros datos, para que la
          ficha no sea thin content. Solo en el idioma base (está en español). */}
      {!novela.sinopsis && idioma === IDIOMA_BASE && (
        <p class="mt-4 text-base-600 dark:text-base-300 leading-relaxed text-pretty">
          {introGenerada}
        </p>
      )}

      {/* Un solo script para todos los bloques expandibles (sinopsis, títulos
          alternos): mide TRAS el layout —si no, scrollHeight/clientHeight aún no
          están calculados y el botón nunca saldría aunque el texto se recorte—. */}
      <script is:inline>
        (() => {
          const run = () => {
            document.querySelectorAll('[data-expandible]').forEach((box) => {
              const p = box.querySelector('[data-exp]');
              const btn = box.querySelector('[data-exp-btn]');
              if (!p || !btn || p.scrollHeight <= p.clientHeight + 4) return;
              btn.hidden = false;
              btn.addEventListener('click', () => {
                const recortada = p.classList.toggle(p.dataset.clamp);
                btn.textContent = recortada ? btn.dataset.mas : btn.dataset.menos;
              });
            });
          };
          if (document.readyState === 'loading')
            addEventListener('DOMContentLoaded', () => requestAnimationFrame(run));
          else requestAnimationFrame(run);
        })();
      </script>

      <div class="mt-5 flex flex-wrap gap-3">
        {hayLecturaInterna && (
          <a
            href={`${base}/capitulo-1`}
            data-empezar
            data-base={base}
            class="neu-sm neu-press rounded-xl px-4 py-2.5 text-sm font-medium text-acento-500"
          >
            {dic.empezarALeer}
          </a>
        )}
        <button
          data-favorito
          data-slug={novela.slug}
          aria-pressed="false"
          class="neu-sm neu-press rounded-xl px-4 py-2.5 text-sm font-medium flex items-center gap-2 aria-pressed:text-acento-500"
        >
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linejoin="round" class="size-4">
            <path d="M6 4h12v16l-6-4-6 4z" />
          </svg>
          <span data-favorito-texto>{dic.guardar}</span>
        </button>
      </div>
    </div>
  </article>

  <div class="mt-6 grid gap-6">
    {/* La brecha, en grande y antes que nada. Es un bucle abierto: un número
        concreto de capítulos que YA existen y todavía no leíste pesa mucho más
        que "hay novela disponible". Y lleva a /equivalencia, que responde la
        pregunta entera. */}
    {brecha && brecha.faltan > 0 && (
      <a
        href={`${base}/equivalencia`}
        class="neu rounded-2xl p-5 flex flex-wrap items-center gap-x-6 gap-y-3 transition-transform duration-200 hover:-translate-y-0.5"
      >
        <span class="min-w-0 flex-1">
          <span class="block font-semibold text-base-800 dark:text-base-100">
            Te faltan {brecha.faltan} capítulos de historia
          </span>
          <span class="block mt-0.5 text-sm text-base-500 text-pretty">
            El manhwa va por el {brecha.manhwa} y la novela por el {brecha.novela}. Mira por cuál
            capítulo seguir →
          </span>
        </span>
        <span class="flex items-center gap-3 tabular-nums">
          <span class="text-center">
            <span class="block text-lg font-bold text-base-700 dark:text-base-200">{brecha.manhwa}</span>
            <span class="block text-[11px] text-base-400">manhwa</span>
          </span>
          <span class="text-base-300 dark:text-base-600">→</span>
          <span class="text-center">
            <span class="block text-lg font-bold text-acento-500">{brecha.novela}</span>
            <span class="block text-[11px] text-base-400">novela</span>
          </span>
        </span>
      </a>
    )}

    {/* Puente manhwa↔novela: el valor agregado del sitio. Se muestra si hay
        anclas, aunque no exista lector interno (usa la lista externa). */}
    <ManhwaToNovelBridge slug={novela.slug} anclas={anclas} mostrar={tieneAmbos} />
    {hayLecturaInterna && (
      <>
        <SyncExplanationBanner />
        <ListaCapitulos capitulos={capitulos} slug={novela.slug} />
      </>
    )}
    {/* «<obra> cap 1200» tiene su propia página; esto es por dónde se entra. */}
    {ultimosNumeros.length > 0 && idioma === IDIOMA_BASE && (
      <section class="mb-6" aria-labelledby="caps-sueltos">
        <h2 id="caps-sueltos" class="font-semibold text-base-800 dark:text-base-100 mb-2">
          ¿Buscas un capítulo suelto?
        </h2>
        <p class="text-sm text-base-500 mb-3">
          Cada capítulo de {novela.titulo} tiene su página con todas las fuentes que lo tienen.
        </p>
        {/* Con 2.000 capítulos, seis atajos no alcanzan: el que busca el 1200 lo
            escribe. Es un <form> de verdad, así que el Intro del teclado móvil
            también vale, y sin JS el campo no estorba. */}
        <form data-ir-cap data-base={base} class="flex items-center gap-2 mb-3">
          <label class="neu-inset rounded-xl px-3 py-1.5 flex items-center gap-2">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" class="size-4 text-base-400">
              <circle cx="11" cy="11" r="7" /><path d="m20 20-4-4" stroke-linecap="round" />
            </svg>
            <input
              name="n"
              type="number"
              inputmode="numeric"
              min="1"
              max="99999"
              required
              placeholder="Nº de capítulo"
              aria-label="Ir a un capítulo por su número"
              class="w-32 bg-transparent outline-none text-sm"
            />
          </label>
          <button class="neu-sm neu-press rounded-xl px-4 py-1.5 text-sm font-medium text-acento-500">Ir</button>
        </form>
        <div class="flex flex-wrap gap-2">
          {ultimosNumeros.map((n) => (
            <a
              href={`${base}/capitulo-${n}`}
              class="text-sm neu-sm neu-press rounded-xl px-3 py-1.5 text-base-600 dark:text-base-300 hover:text-acento-500"
            >
              Capítulo {n}
            </a>
          ))}
        </div>
      </section>
    )}

    <CapitulosExternos fuentes={fuentes} slug={novela.slug} />

    {/* Preguntas frecuentes: contenido propio, útil y con FAQPage en el <head>
        (mismas preguntas, visibles aquí). Solo en el idioma base, donde están
        escritas. Sube el CTR: Google las muestra desplegables bajo el resultado. */}
    {jsonLdFaq.length > 0 && idioma === IDIOMA_BASE && (
      <section aria-labelledby="faq">
        <h2 id="faq" class="font-semibold text-base-800 dark:text-base-100 mb-4">
          Preguntas frecuentes
        </h2>
        <dl class="grid gap-3">
          {preguntas.map((p) => (
            <div class="neu-sm rounded-2xl p-4">
              <dt class="font-medium text-base-700 dark:text-base-200">{p.pregunta}</dt>
              <dd class="mt-1.5 text-sm text-base-500 leading-relaxed text-pretty">{p.respuesta}</dd>
            </div>
          ))}
        </dl>
      </section>
    )}

    {/* Obras relacionadas: además de ser útil, teje la malla de enlaces internos.
        Sin ella cada ficha es un callejón sin salida —el buscador entra y no
        tiene por dónde seguir—, y la autoridad no circula por el catálogo. */}
    {relacionadas.length > 0 && (
      <section aria-labelledby="relacionadas">
        <h2 id="relacionadas" class="font-semibold text-base-800 dark:text-base-100 mb-4">
          {dic.obrasSimilares}
        </h2>
        <ul class="grid grid-cols-1 sm:grid-cols-3 gap-3">
          {relacionadas.map((r) => (
            <li>
              <a
                href={ruta(idioma, `/novela/${r.slug}`)}
                class="neu-sm rounded-xl p-3 flex gap-3 items-center transition-transform duration-200 hover:-translate-y-0.5"
              >
                <img
                  src={r.portadaUrl}
                  alt=""
                  width="40"
                  height="57"
                  loading="lazy"
                  decoding="async"
                  class="w-10 aspect-[7/10] object-cover rounded-lg shrink-0"
                />
                <span class="min-w-0">
                  <span class="block text-sm font-medium text-base-700 dark:text-base-200 line-clamp-2">
                    {r.titulo}
                  </span>
                  {r.titulosAlternativos[0] && (
                    <span class="block text-[11px] text-base-400 truncate">{r.titulosAlternativos[0]}</span>
                  )}
                </span>
              </a>
            </li>
          ))}
        </ul>
      </section>
    )}
  </div>
</Base>

<script>
  import { get, toggleFavorito, ultimoLeido } from '@/lib/progress';
  import { idiomaDeRuta, t } from '@/lib/i18n';

  const dic = t(idiomaDeRuta(location.pathname));
  const boton = document.querySelector<HTMLButtonElement>('[data-favorito]')!;
  const slug = boton.dataset.slug!;
  const texto = boton.querySelector('[data-favorito-texto]')!;
  // Puede no existir: las obras que se leen fuera no tienen lector interno, y
  // son la mayoría del catálogo. Sin este `?` el TypeError se lleva por delante
  // también el botón de favorito, que sí está siempre.
  const empezar = document.querySelector<HTMLAnchorElement>('[data-empezar]');
  const base = empezar?.dataset.base;

  function pintar() {
    const fav = get(slug).esFavorito;
    boton.setAttribute('aria-pressed', String(fav));
    texto.textContent = fav ? dic.guardada : dic.guardar;

    const n = ultimoLeido(slug);
    if (n !== null && empezar && base) {
      empezar.href = `${base}/capitulo-${n + 1}`;
      empezar.textContent = dic.continuarEnCap(n + 1);
    }
  }

  // Ir a la página de un capítulo por su número. La sección solo existe en el
  // idioma base y cuando hay capítulos indexados, de ahí el `?`.
  const irCap = document.querySelector<HTMLFormElement>('[data-ir-cap]');
  irCap?.addEventListener('submit', (e) => {
    e.preventDefault();
    const n = parseInt((irCap.elements.namedItem('n') as HTMLInputElement).value, 10);
    if (n > 0) location.href = `${irCap.dataset.base}/capitulo-${n}`;
  });

  boton.addEventListener('click', () => {
    toggleFavorito(slug);
    pintar();
  });
  window.addEventListener('progress:synced', pintar);
  pintar();
</script>
