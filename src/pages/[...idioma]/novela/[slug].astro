---
import Base from '@/layouts/Base.astro';
import ManhwaToNovelBridge from '@/components/ManhwaToNovelBridge.astro';
import ListaCapitulos from '@/components/ListaCapitulos.astro';
import CapitulosExternos from '@/components/CapitulosExternos.astro';
import SyncExplanationBanner from '@/components/SyncExplanationBanner.astro';
import { formatos, fuentesDe, getCapitulos, getCapitulosExternos, getEquivalencias, getNovelas } from '@/lib/api';
import { IDIOMAS, idiomaDeRuta, ruta, t } from '@/lib/i18n';
import { idiomasDeObra, paramsDeIdioma } from '@/lib/publicables';
import { relacionadasDe } from '@/lib/catalogo';
import { slugCategoria } from '@/lib/categorias';

export async function getStaticPaths() {
  const novelas = await getNovelas();
  // El catálogo sin prosa traducida se publica solo en `es` (ver idiomasDeObra):
  // sin esto serían 8.600 obras × 7 idiomas y el build no cabe en el tiempo de CF.
  const paramDe = new Map(paramsDeIdioma().map((p) => [p.codigo, p.idioma]));
  return novelas.flatMap((novela) =>
    idiomasDeObra(novela)
      .filter((c) => paramDe.has(c))
      .map((codigo) => ({ params: { idioma: paramDe.get(codigo), slug: novela.slug } })),
  );
}

const idioma = idiomaDeRuta(Astro.url.pathname);
const dic = t(idioma);
const { slug } = Astro.params;

const novelas = await getNovelas(idioma);
const novela = novelas.find((n) => n.slug === slug)!;
const capitulos = await getCapitulos(novela.slug, idioma);
const externos = await getCapitulosExternos(novela.slug);
// Agrupados POR SCAN (estilo zonascans): cada fuente es su tarjeta, ordenadas
// por número de capítulos. Y qué formatos hay, para el aviso "Manhwa · Novela".
const fuentes = fuentesDe(externos);
const formatosDisponibles = formatos(externos);
const anclas = await getEquivalencias(novela.slug);
// El puente se muestra si la obra tiene manhwa Y novela (aunque no haya anclas:
// la comunidad puede aportar/votar la primera).
const tieneAmbos = formatosDisponibles.length === 2;
// Sin capítulos internos, la novela vive fuera: oculto el lector propio,
// el sync, el puente manhwa↔novela y el CTA de "empezar a leer" (rompería
// en /capitulo-1). La página muestra la ficha + los enlaces externos.
const hayLecturaInterna = capitulos.length > 0;

const base = ruta(idioma, `/novela/${novela.slug}`);
const url = new URL(base, Astro.site).toString();

// Cómo la busca la gente: el título en inglés suele ser la consulta más común
// fuera de Latinoamérica, así que va también en el <title>.
const [tituloIngles] = novela.titulosAlternativos;
const relacionadas = await relacionadasDe(novela);
const alternos = novela.titulosAlternativos.join(', ');

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Book',
  '@id': url,
  name: novela.titulo,
  alternateName: novela.titulosAlternativos,
  url,
  description: novela.sinopsis,
  image: new URL(novela.portadaUrl, Astro.site).toString(),
  inLanguage: IDIOMAS[idioma].htmlLang,
  bookFormat: 'https://schema.org/EBook',
  genre: novela.categorias,
  numberOfPages: capitulos.length,
  author: { '@type': 'Organization', name: 'ManhwaToNovel' },
  potentialAction: {
    '@type': 'ReadAction',
    target: {
      '@type': 'EntryPoint',
      urlTemplate: `${url}/capitulo-1`,
      actionPlatform: [
        'https://schema.org/DesktopWebPlatform',
        'https://schema.org/MobileWebPlatform',
      ],
    },
  },
};
---

<Base
  titulo={dic.seoNovelaTitulo(novela.titulo, tituloIngles)}
  descripcion={dic.seoNovelaDesc(novela.titulo, alternos, capitulos.length)}
  imagen={novela.portadaUrl}
  tipo="book"
  jsonLd={jsonLd}
  idiomas={idiomasDeObra(novela)}
>
  <nav class="text-sm text-base-400 mb-5" aria-label="breadcrumb">
    <a href={ruta(idioma)} class="hover:text-acento-500">{dic.navInicio}</a>
    <span class="mx-1.5">/</span>
    <a href={ruta(idioma, '/novelas')} class="hover:text-acento-500">{dic.navNovelas}</a>
    <span class="mx-1.5">/</span>
    <span class="text-base-500">{novela.titulo}</span>
  </nav>

  <article class="neu rounded-2xl p-5 sm:p-6 flex flex-col sm:flex-row gap-6">
    <img
      src={novela.portadaUrl}
      data-fb={JSON.stringify((novela.portadas ?? []).filter((u) => u !== novela.portadaUrl))}
      alt={novela.titulo}
      width="224"
      height="320"
      fetchpriority="high"
      decoding="async"
      class="w-40 sm:w-56 self-center sm:self-start aspect-[7/10] object-cover rounded-2xl neu-sm"
    />

    <div class="min-w-0 flex-1">
      <div class="flex items-center gap-2 text-xs font-medium">
        <span
          class:list={[
            'neu-inset rounded-lg px-2 py-1',
            novela.estado === 'En emisión' ? 'text-emerald-500' : 'text-base-500',
          ]}>{novela.estado === 'En emisión' ? dic.enEmision : dic.finalizado}</span
        >
        {hayLecturaInterna && <span class="text-base-400 tabular-nums">{dic.nCapitulos(capitulos.length)}</span>}
        {/* Que se sepa de un vistazo si hay manhwa, novela o ambos. */}
        {formatosDisponibles.map((f) => (
          <span
            class:list={[
              'rounded-lg px-2 py-1 neu-inset capitalize',
              f === 'novela' ? 'text-acento-500' : 'text-emerald-500',
            ]}
          >
            {f}
          </span>
        ))}
      </div>

      {/* El nombre en inglés va DENTRO del h1: fuera de Latinoamérica es la
          consulta más común ("Return of the Mount Hua Sect"), y el h1 es la
          señal de relevancia más fuerte de la página después del <title>. */}
      <h1 class="mt-2 text-2xl sm:text-3xl font-bold tracking-tight text-base-800 dark:text-base-50 text-balance">
        {novela.titulo}
        {tituloIngles && tituloIngles !== novela.titulo && (
          <span class="block mt-1 text-base sm:text-lg font-medium text-base-500">{tituloIngles}</span>
        )}
      </h1>

      {/* Texto visible, no meta keywords: es lo que Google indexa de verdad. */}
      {novela.titulosAlternativos.length > 0 && (
        <div class="mt-2" data-expandible>
          {/* Todos los nombres están SIEMPRE en el HTML (Google los lee para que
              te encuentren por el título en inglés/coreano); el recorte es solo
              visual, con "ver más" para no comer pantalla en móvil. */}
          <p data-exp data-clamp="line-clamp-2" class="text-sm text-base-500 line-clamp-2">
            <span class="text-base-400">{dic.tambienConocida}</span>{' '}
            <span class="text-base-600 dark:text-base-300">
              {novela.titulosAlternativos.join(' · ')}
            </span>
          </p>
          <button hidden data-exp-btn data-mas="Ver más" data-menos="Ver menos" class="mt-0.5 text-xs font-medium text-acento-500">
            Ver más
          </button>
        </div>
      )}

      <div class="mt-3 flex flex-wrap gap-2">
        {
          novela.categorias.map((c) => (
            <a
              href={ruta(idioma, `/categoria/${slugCategoria(c)}`)}
              class="text-xs text-base-500 neu-inset neu-press rounded-lg px-2 py-1 hover:text-acento-500"
            >
              {c}
            </a>
          ))
        }
      </div>

      {novela.sinopsis && (
        <div class="mt-4" data-expandible>
          {/* Recortada a 6 líneas; el botón (que el script muestra solo si el
              texto rebasa) la despliega. En móvil una sinopsis larga comía media
              pantalla antes de ver los capítulos. */}
          <p
            data-exp
            data-clamp="line-clamp-6"
            class="text-base-600 dark:text-base-300 leading-relaxed text-pretty line-clamp-6"
          >
            {novela.sinopsis}
          </p>
          <button hidden data-exp-btn data-mas="Leer más" data-menos="Leer menos" class="mt-1 text-sm font-medium text-acento-500">
            Leer más
          </button>
        </div>
      )}

      {/* Un solo script para todos los bloques expandibles (sinopsis, títulos
          alternos): mide TRAS el layout —si no, scrollHeight/clientHeight aún no
          están calculados y el botón nunca saldría aunque el texto se recorte—. */}
      <script is:inline>
        (() => {
          const run = () => {
            document.querySelectorAll('[data-expandible]').forEach((box) => {
              const p = box.querySelector('[data-exp]');
              const btn = box.querySelector('[data-exp-btn]');
              if (!p || !btn || p.scrollHeight <= p.clientHeight + 4) return;
              btn.hidden = false;
              btn.addEventListener('click', () => {
                const recortada = p.classList.toggle(p.dataset.clamp);
                btn.textContent = recortada ? btn.dataset.mas : btn.dataset.menos;
              });
            });
          };
          if (document.readyState === 'loading')
            addEventListener('DOMContentLoaded', () => requestAnimationFrame(run));
          else requestAnimationFrame(run);
        })();
      </script>

      <div class="mt-5 flex flex-wrap gap-3">
        {hayLecturaInterna && (
          <a
            href={`${base}/capitulo-1`}
            data-empezar
            data-base={base}
            class="neu-sm neu-press rounded-xl px-4 py-2.5 text-sm font-medium text-acento-500"
          >
            {dic.empezarALeer}
          </a>
        )}
        <button
          data-favorito
          data-slug={novela.slug}
          aria-pressed="false"
          class="neu-sm neu-press rounded-xl px-4 py-2.5 text-sm font-medium flex items-center gap-2 aria-pressed:text-acento-500"
        >
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linejoin="round" class="size-4">
            <path d="M6 4h12v16l-6-4-6 4z" />
          </svg>
          <span data-favorito-texto>{dic.guardar}</span>
        </button>
      </div>
    </div>
  </article>

  <div class="mt-6 grid gap-6">
    {/* Puente manhwa↔novela: el valor agregado del sitio. Se muestra si hay
        anclas, aunque no exista lector interno (usa la lista externa). */}
    <ManhwaToNovelBridge slug={novela.slug} anclas={anclas} mostrar={tieneAmbos} />
    {hayLecturaInterna && (
      <>
        <SyncExplanationBanner />
        <ListaCapitulos capitulos={capitulos} slug={novela.slug} />
      </>
    )}
    <CapitulosExternos fuentes={fuentes} slug={novela.slug} />

    {/* Obras relacionadas: además de ser útil, teje la malla de enlaces internos.
        Sin ella cada ficha es un callejón sin salida —el buscador entra y no
        tiene por dónde seguir—, y la autoridad no circula por el catálogo. */}
    {relacionadas.length > 0 && (
      <section aria-labelledby="relacionadas">
        <h2 id="relacionadas" class="font-semibold text-base-800 dark:text-base-100 mb-4">
          Obras similares
        </h2>
        <ul class="grid grid-cols-1 sm:grid-cols-3 gap-3">
          {relacionadas.map((r) => (
            <li>
              <a
                href={ruta(idioma, `/novela/${r.slug}`)}
                class="neu-sm rounded-xl p-3 flex gap-3 items-center transition-transform duration-200 hover:-translate-y-0.5"
              >
                <img
                  src={r.portadaUrl}
                  alt=""
                  width="40"
                  height="57"
                  loading="lazy"
                  decoding="async"
                  class="w-10 aspect-[7/10] object-cover rounded-lg shrink-0"
                />
                <span class="min-w-0">
                  <span class="block text-sm font-medium text-base-700 dark:text-base-200 line-clamp-2">
                    {r.titulo}
                  </span>
                  {r.titulosAlternativos[0] && (
                    <span class="block text-[11px] text-base-400 truncate">{r.titulosAlternativos[0]}</span>
                  )}
                </span>
              </a>
            </li>
          ))}
        </ul>
      </section>
    )}
  </div>
</Base>

<script>
  import { get, toggleFavorito, ultimoLeido } from '@/lib/progress';
  import { idiomaDeRuta, t } from '@/lib/i18n';

  const dic = t(idiomaDeRuta(location.pathname));
  const boton = document.querySelector<HTMLButtonElement>('[data-favorito]')!;
  const slug = boton.dataset.slug!;
  const texto = boton.querySelector('[data-favorito-texto]')!;
  // Puede no existir: las obras que se leen fuera no tienen lector interno, y
  // son la mayoría del catálogo. Sin este `?` el TypeError se lleva por delante
  // también el botón de favorito, que sí está siempre.
  const empezar = document.querySelector<HTMLAnchorElement>('[data-empezar]');
  const base = empezar?.dataset.base;

  function pintar() {
    const fav = get(slug).esFavorito;
    boton.setAttribute('aria-pressed', String(fav));
    texto.textContent = fav ? dic.guardada : dic.guardar;

    const n = ultimoLeido(slug);
    if (n !== null && empezar && base) {
      empezar.href = `${base}/capitulo-${n + 1}`;
      empezar.textContent = dic.continuarEnCap(n + 1);
    }
  }

  boton.addEventListener('click', () => {
    toggleFavorito(slug);
    pintar();
  });
  window.addEventListener('progress:synced', pintar);
  pintar();
</script>
