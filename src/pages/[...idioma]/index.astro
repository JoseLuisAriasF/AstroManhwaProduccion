---
import Base from '@/layouts/Base.astro';
import NovelaCard from '@/components/NovelaCard.astro';
import Carrusel from '@/components/Carrusel.astro';
import SyncExplanationBanner from '@/components/SyncExplanationBanner.astro';
import { formatos, getCapitulos, getCapitulosExternos, getEquivalenciasCombinadas, getNovelas } from '@/lib/api';
import { IDIOMA_BASE, idiomaDeRuta, ruta, t } from '@/lib/i18n';
import { idiomasDeObra, paramsDeIdioma } from '@/lib/publicables';
import { rangos } from '@/lib/rangos';

export function getStaticPaths() {
  return paramsDeIdioma().map(({ idioma }) => ({ params: { idioma } }));
}

const idioma = idiomaDeRuta(Astro.url.pathname);
const dic = t(idioma);
// La ficha en el idioma donde existe: el catálogo va solo en `es`, así que en
// /en/ los enlaces apuntan a /novela/… (base) y no a un 404 en /en/novela/….
const fichaHref = (n: { slug: string; sinopsis?: string }) =>
  ruta(idiomasDeObra(n).includes(idioma) ? idioma : IDIOMA_BASE, `/novela/${n.slug}`);

const novelas = await getNovelas(idioma);
const conTotales = await Promise.all(
  novelas.map(async (n) => {
    const [caps, externos] = await Promise.all([getCapitulos(n.slug), getCapitulosExternos(n.slug)]);
    const fmts = formatos(externos);
    return {
      novela: n,
      total: caps.length,
      capsExternos: externos.length, // proxy de popularidad (sin datos de vistas)
      rangos: rangos(externos.map((e) => e.numero)),
      formatos: fmts,
      ambos: fmts.length === 2,
    };
  }),
);

// El catálogo de la home muestra por defecto SOLO las de doble formato (el
// gancho); el resto vive en un índice y aparece al buscar. Renderizar las 8.600
// pesaba 10 MB y arrastraba el navegador.
const destacadas = conTotales.filter((o) => o.ambos);
// El índice del buscador YA NO se incrusta aquí: vive en /buscar.json y se pide
// solo cuando hace falta (al teclear, o al pintar "Continuar leyendo"). Estaba
// inline y eran 2,5 MB de JSON en el HTML de CADA visita a la portada —más de la
// mitad del peso de la página más importante del sitio— para un dato que la
// mayoría de visitantes nunca usa.

// Carrusel: las de doble formato (el gancho) más "populares". Sin datos de
// vistas, se ordena por nº de capítulos indexados (proxy: obra popular = mucha
// scanlation). Cada una lleva su equivalencia más avanzada (admin + comunidad),
// que se pinta DENTRO de la imagen del carrusel.
const carruselBase = (destacadas.length ? destacadas : conTotales)
  .filter((o) => o.capsExternos > 0)
  .sort((a, b) => b.capsExternos - a.capsExternos)
  .slice(0, 10);
const carrusel = await Promise.all(
  carruselBase.map(async (o) => {
    const anclas = await getEquivalenciasCombinadas(o.novela.slug);
    const ancla = anclas.length
      ? anclas.reduce((a, b) => (b.capituloManhwa > a.capituloManhwa ? b : a))
      : null;
    return {
      novela: o.novela,
      formatos: (o.formatos.length ? o.formatos : [o.novela.tipo]) as ('manhwa' | 'novela')[],
      total: o.capsExternos,
      ancla,
      href: fichaHref(o.novela),
    };
  }),
);

// Nuevos lanzamientos: los "match" (tienen manhwa Y novela), por fecha de
// descubrimiento. Es lo que hace único al sitio, no cualquier obra suelta.
const nuevos = [...conTotales]
  .filter((o) => o.ambos && o.novela.creadaEn)
  .sort((a, b) => (a.novela.creadaEn! < b.novela.creadaEn! ? 1 : -1))
  .slice(0, 12);

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'CollectionPage',
  name: 'ManhwaToNovel',
  inLanguage: idioma,
  description: dic.sitioDescripcion,
  // Solo las destacadas del carrusel, NO el catálogo entero. `hasPart` con las
  // 6.800 obras eran 1,5 MB de JSON-LD en cada carga de la portada —un tercio
  // del peso de la página— y Google no lo aprovecha: descubre las fichas por el
  // sitemap y los enlaces, no por un schema gigante. Las obras siguen enlazadas
  // en el HTML (tarjetas, /titulos/*), que es lo que de verdad cuenta.
  hasPart: carrusel.map((c) => ({
    '@type': 'Book',
    name: c.novela.titulo,
    alternateName: c.novela.titulosAlternativos,
    url: new URL(c.href, Astro.site).toString(),
  })),
};
---

<Base
  titulo={`ManhwaToNovel · ${dic.seoInicio}`}
  descripcion={dic.sitioDescripcion}
  anchoCompleto
  jsonLd={jsonLd}
>
  {/* Colapso por CSS: sin JS igual se ve la lista recortada (el botón solo la
      expande). El valor de data-colapsable dice cuántas caben antes de cortar. */}
  <style is:inline>
    [data-colapsable="6"]:not([data-expandido]) > :nth-child(n + 7) { display: none; }
    [data-colapsable="4"]:not([data-expandido]) > :nth-child(n + 5) { display: none; }
  </style>
  {/* Carrusel como PORTADA: lo primero que se ve, en grande. El texto de héroe
      va debajo. */}
  <div id="destacados" class="mb-8">
    <Carrusel items={carrusel} titulo="Destacados: manhwa + novela" />
  </div>

  <!-- Hero -->
  <section class="relative text-center py-10 sm:py-16 overflow-hidden">
    <div
      aria-hidden="true"
      class="pointer-events-none absolute inset-x-0 -top-24 h-72 opacity-60 blur-3xl
             bg-[radial-gradient(closest-side,theme(colors.acento.400),transparent)]
             dark:opacity-25"
    >
    </div>

    <div class="relative">
      <span class="neu-inset rounded-full px-3 py-1 text-xs font-medium text-acento-500">
        {dic.heroBadge}
      </span>
      <h1
        class="mt-5 text-4xl sm:text-6xl font-bold tracking-tight text-base-800 dark:text-base-50 text-balance leading-[1.05]"
      >
        {dic.heroTitulo}
      </h1>
      <p class="mt-5 text-base-500 max-w-xl mx-auto text-pretty">{dic.heroSub}</p>

      <div class="mt-8 max-w-lg mx-auto">
        <label class="neu-inset rounded-2xl flex items-center gap-3 px-4 py-3.5">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" class="size-5 text-base-400 shrink-0">
            <circle cx="11" cy="11" r="7" /><path d="m20 20-4-4" stroke-linecap="round" />
          </svg>
          <input
            id="buscador"
            type="search"
            placeholder={dic.buscarPlaceholder}
            aria-label={dic.buscarEtiqueta}
            autocomplete="off"
            class="w-full bg-transparent outline-none text-base-800 dark:text-base-100 placeholder:text-base-400"
          />
        </label>
      </div>

      <dl class="mt-8 flex justify-center gap-3 flex-wrap text-sm">
        {
          (
            [
              [conTotales.length, dic.statNovelas],
              [conTotales.reduce((s, n) => s + n.total, 0), dic.statCapitulos],
              ['100%', dic.statGratis],
            ] as const
          ).filter(([valor]) => valor !== 0).map(([valor, etiqueta]) => (
            <div class="neu-sm rounded-xl px-4 py-2">
              <dt class="sr-only">{etiqueta}</dt>
              <dd>
                <span class="font-semibold text-base-800 dark:text-base-100 tabular-nums">{valor}</span>
                <span class="text-base-500"> {etiqueta}</span>
              </dd>
            </div>
          ))
        }
      </dl>
    </div>
  </section>

  <!-- Continuar leyendo (solo si hay progreso guardado) -->
  <section id="continuar" hidden class="mb-10">
    <h2 class="font-semibold text-base-800 dark:text-base-100 mb-4">{dic.continuarLeyendo}</h2>
    {/* Se muestran 4; el resto, tras "Ver más". El JS pone/quita el botón según
        cuántas haya en progreso. */}
    <div id="continuar-lista" data-colapsable="4" class="grid grid-cols-1 sm:grid-cols-2 gap-3"></div>
    <button
      id="continuar-mas"
      hidden
      data-mas
      class="mt-4 mx-auto block neu-sm neu-press rounded-xl px-4 py-2 text-sm font-medium text-acento-500"
    >{dic.verMas}</button>
  </section>

  <div class="mb-10"><SyncExplanationBanner /></div>

  {nuevos.length > 0 && (
    <section id="nuevos" class="mb-10">
      <h2 class="font-semibold text-base-800 dark:text-base-100 mb-1">Nuevos lanzamientos</h2>
      <p class="text-sm text-base-500 mb-4">Novelas con su manhwa (y viceversa), recién añadidas.</p>
      {/* Se muestran 6; el resto se despliega con "Ver más". El colapso es CSS
          (nth-child) para que no dependa de JS y funcione sin él. */}
      <div data-colapsable="6" class="grid grid-cols-1 sm:grid-cols-2 gap-4">
        {nuevos.map(({ novela, formatos }) => (
          <NovelaCard novela={novela} formatos={formatos} />
        ))}
      </div>
      {nuevos.length > 6 && (
        <button
          data-mas
          class="mt-4 mx-auto block neu-sm neu-press rounded-xl px-4 py-2 text-sm font-medium text-acento-500"
        >
          {dic.verMas}
        </button>
      )}
    </section>
  )}

  {/* Las tres páginas que solo este sitio puede tener. Van en la portada
      porque es de donde sale la autoridad que necesitan para posicionar: una
      página nueva enlazada solo desde el pie tarda meses en despegar. */}
  <nav class="mb-10 grid grid-cols-1 sm:grid-cols-3 gap-3" aria-label="Secciones">
    {[
      {
        href: ruta(IDIOMA_BASE, '/rankings'),
        titulo: 'La novela va por delante',
        sub: 'Dónde queda más historia sin dibujar',
      },
      {
        href: ruta(IDIOMA_BASE, '/novedades'),
        titulo: 'Capítulos nuevos',
        sub: 'Lo que se movió en los últimos días',
      },
      {
        href: ruta(IDIOMA_BASE, '/titulos/a'),
        titulo: 'Todos los títulos',
        sub: 'La misma obra, con sus otros nombres',
      },
    ].map((x) => (
      <a
        href={x.href}
        hreflang="es"
        class="neu-sm neu-press rounded-2xl p-4 transition-transform duration-200 hover:-translate-y-0.5"
      >
        <span class="block font-medium text-base-700 dark:text-base-200">{x.titulo}</span>
        <span class="block mt-0.5 text-sm text-base-400">{x.sub}</span>
      </a>
    ))}
  </nav>

  <!-- Catálogo -->
  <section>
    <h2 id="titulo-catalogo" class="font-semibold text-base-800 dark:text-base-100">
      {dic.catalogo}
    </h2>
    <p class="mt-1 mb-4 text-sm text-base-500" data-sub>
      {destacadas.length} obras con <strong class="text-acento-500">manhwa y novela</strong>. Busca arriba para ver todo el catálogo.
    </p>
    <div id="destacadas" class="grid grid-cols-1 sm:grid-cols-2 gap-4">
      {destacadas.map(({ novela, total, rangos, formatos }) => (
        <NovelaCard novela={novela} totalCapitulos={total} rangos={rangos} formatos={formatos} />
      ))}
    </div>
    <div id="resultados" hidden class="grid grid-cols-1 sm:grid-cols-2 gap-4"></div>
    <p id="sin-resultados" hidden class="neu-inset rounded-2xl p-8 text-center text-base-500 mt-2">
      {dic.sinResultados}
    </p>
  </section>
</Base>

<script>
  import { getAll, ultimoLeido } from '@/lib/progress';
  import { IDIOMA_BASE, idiomaDeRuta, ruta, t } from '@/lib/i18n';

  type Item = { slug: string; q: string; titulo: string; alt: string; portada: string; fmt: string[]; href: string };

  /**
   * El catálogo se pide a /buscar.json la PRIMERA vez que hace falta —al
   * teclear, o al pintar "Continuar leyendo"— en vez de venir incrustado en el
   * HTML. Se memoiza la promesa: varias llamadas seguidas comparten la descarga.
   */
  let indice: Item[] = [];
  let porSlug = new Map<string, Item>();
  let cargando: Promise<void> | null = null;

  function cargarIndice(): Promise<void> {
    if (indice.length) return Promise.resolve();
    cargando ??= fetch('/buscar.json')
      .then((r) => r.json())
      .then((datos: { s: string; t: string; a?: string[]; p?: string; f?: string[] }[]) => {
        indice = datos.map((d) => ({
          slug: d.s,
          titulo: d.t,
          alt: d.a?.[0] ?? '',
          q: [d.t, ...(d.a ?? [])].join(' ').toLowerCase(),
          portada: d.p ?? '',
          fmt: d.f ?? [],
          // El índice es del catálogo base; la ficha base existe siempre.
          href: ruta(IDIOMA_BASE, `/novela/${d.s}`),
        }));
        porSlug = new Map(indice.map((it) => [it.slug, it]));
      })
      .catch(() => {
        /* sin índice, el buscador no encuentra: mejor que romper la página */
      });
    return cargando;
  }

  const idioma = idiomaDeRuta(location.pathname);
  const dic = t(idioma);

  const esc = (s: string) =>
    s.replace(/[&<>"]/g, (c) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;' })[c]!);

  const tarjeta = (it: Item) => {
    const tags = it.fmt
      .map(
        (f) =>
          `<span class="rounded-lg px-2 py-0.5 neu-inset capitalize ${f === 'manhwa' ? 'text-emerald-500' : 'text-acento-500'}">${f}</span>`,
      )
      .join('');
    return `<article class="neu rounded-2xl overflow-hidden flex gap-4 p-3">
      <a href="${it.href}" class="shrink-0">
        <img src="${esc(it.portada)}" alt="${esc(it.titulo)}" width="112" height="160" loading="lazy" decoding="async"
             class="w-20 sm:w-28 aspect-[7/10] object-cover rounded-xl neu-sm" />
      </a>
      <div class="min-w-0 flex flex-col py-1">
        <div class="flex items-center gap-2 text-[11px] font-medium">${tags}</div>
        <h3 class="mt-1.5 font-semibold leading-snug text-base-800 dark:text-base-100">
          <a href="${it.href}" class="hover:text-acento-500 transition-colors">${esc(it.titulo)}</a>
        </h3>
        <p class="text-xs text-base-400 truncate">${esc(it.alt)}</p>
      </div>
    </article>`;
  };

  // Chip "Vas por el cap. N" en las tarjetas visibles + fila "Continuar leyendo"
  // (esta última se arma desde el índice, que tiene todas las obras).
  function pintarProgreso() {
    document.querySelectorAll<HTMLElement>('[data-novela]').forEach((card) => {
      const n = ultimoLeido(card.dataset.novela!);
      const chip = card.querySelector<HTMLElement>('[data-continuar]');
      if (!chip) return;
      chip.hidden = n === null;
      if (n !== null) chip.textContent = dic.vasPorCap(n);
    });

    const enCurso = Object.values(getAll()).filter((p) => p.capitulosLeidos.length > 0);
    const seccion = document.getElementById('continuar') as HTMLElement;
    seccion.hidden = enCurso.length === 0;

    // Botón "Ver más": solo si hay más de 4 en progreso. Se reinicia colapsado
    // cada vez que se repinta (p.ej. tras sincronizar).
    const lista = document.getElementById('continuar-lista') as HTMLElement;
    const btnMas = document.getElementById('continuar-mas') as HTMLElement;
    const sobran = enCurso.length > 4;
    btnMas.hidden = !sobran;
    if (sobran) {
      delete lista.dataset.expandido;
      btnMas.textContent = dic.verMas;
    }

    document.getElementById('continuar-lista')!.innerHTML = enCurso
      .map((p) => {
        const it = porSlug.get(p.novelaSlug);
        const siguiente = Math.max(...p.capitulosLeidos) + 1;
        const titulo = it?.titulo ?? p.novelaSlug;
        const portada = it?.portada ?? '';
        // No alojamos capítulos: el enlace lleva a la ficha de la obra (donde
        // están las fuentes), no a /capitulo-N, que no existe. El número solo se
        // muestra como referencia de por dónde iba.
        const href = it?.href ?? `/novela/${p.novelaSlug}`;
        return `
        <a href="${href}" class="neu rounded-2xl p-3 flex items-center gap-3 transition-transform duration-200 hover:-translate-y-0.5">
          <img src="${esc(portada)}" alt="" width="48" height="69" class="w-12 aspect-[7/10] object-cover rounded-lg neu-sm shrink-0" />
          <span class="min-w-0 flex-1">
            <span class="block text-sm font-medium text-base-800 dark:text-base-100 truncate">${esc(titulo)}</span>
            <span class="block text-xs text-base-500">${dic.continuarEnCapitulo(siguiente)}</span>
          </span>
          <span class="text-acento-500 shrink-0 pr-1" aria-hidden="true">→</span>
        </a>`;
      })
      .join('');
  }
  // Se pinta ya con lo que hay (el slug basta como texto) y, si el lector tiene
  // progreso guardado, se baja el índice para completar título y portada. Quien
  // llega por primera vez no descarga nada: es la mayoría del tráfico.
  pintarProgreso();
  if (Object.keys(getAll()).length) cargarIndice().then(pintarProgreso);
  window.addEventListener('progress:synced', pintarProgreso);

  // "Ver más / Ver menos": expande la lista colapsada de su misma sección.
  document.querySelectorAll<HTMLButtonElement>('[data-mas]').forEach((btn) => {
    btn.addEventListener('click', () => {
      const lista = btn.closest('section')?.querySelector<HTMLElement>('[data-colapsable]');
      if (!lista) return;
      const abierto = lista.toggleAttribute('data-expandido');
      btn.textContent = abierto ? dic.verMenos : dic.verMas;
    });
  });

  // Buscador: sin texto, el catálogo muestra solo doble formato; al escribir se
  // abre a todo (desde el índice) y se ocultan las demás secciones.
  const input = document.getElementById('buscador') as HTMLInputElement;
  const destacadas = document.getElementById('destacadas') as HTMLElement;
  const resultados = document.getElementById('resultados') as HTMLElement;
  const sub = document.querySelector<HTMLElement>('[data-sub]');
  const vacio = document.getElementById('sin-resultados') as HTMLElement;
  const titulo = document.getElementById('titulo-catalogo') as HTMLElement;
  const secciones = ['continuar', 'destacados', 'nuevos']
    .map((id) => document.getElementById(id))
    .filter((s): s is HTMLElement => s !== null);
  const visiblePrevio = new Map(secciones.map((s) => [s, !s.hidden]));

  input.addEventListener('input', async () => {
    const q = input.value.trim().toLowerCase();
    if (q === '') {
      resultados.hidden = true;
      resultados.innerHTML = '';
      destacadas.hidden = false;
      if (sub) sub.hidden = false;
      secciones.forEach((s) => (s.hidden = !visiblePrevio.get(s)));
      vacio.hidden = true;
      titulo.textContent = dic.catalogo;
      pintarProgreso();
      return;
    }
    // La primera pulsación baja el índice; las siguientes ya lo tienen.
    await cargarIndice();
    // Con el índice ya en memoria, el usuario pudo seguir tecleando: se relee
    // el valor actual para no pintar resultados de una consulta vieja.
    if (input.value.trim().toLowerCase() !== q) return;
    const todos = indice.filter((it) => it.q.includes(q));
    const hits = todos.slice(0, 60);
    destacadas.hidden = true;
    if (sub) sub.hidden = true;
    secciones.forEach((s) => (s.hidden = true));
    resultados.innerHTML = hits.map(tarjeta).join('');
    resultados.hidden = hits.length === 0;
    vacio.hidden = hits.length > 0;
    titulo.textContent = dic.resultados(todos.length);
  });

  // ?q=… : deja la búsqueda enlazable y compartible, y es lo que hace legítimo
  // el SearchAction del schema (la caja de búsqueda propia en Google apunta
  // aquí). Sin esto, marcar una URL de búsqueda que no filtra nada sería
  // marcado engañoso. Se aplica al cargar y se refleja en la barra al teclear,
  // con replaceState para no llenar el historial con una entrada por letra.
  const qInicial = new URLSearchParams(location.search).get('q');
  if (qInicial) {
    input.value = qInicial;
    input.dispatchEvent(new Event('input'));
  }
  input.addEventListener('input', () => {
    const url = new URL(location.href);
    const v = input.value.trim();
    if (v) url.searchParams.set('q', v);
    else url.searchParams.delete('q');
    history.replaceState(null, '', url);
  });
</script>
