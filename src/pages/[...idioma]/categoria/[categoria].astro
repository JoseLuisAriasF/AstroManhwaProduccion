---
import Base from '@/layouts/Base.astro';
import NovelaCard from '@/components/NovelaCard.astro';
import { formatos, getCapitulosExternos, getNovelas } from '@/lib/api';
import { idiomaDeRuta, ruta, t } from '@/lib/i18n';
import { migas } from '@/lib/seo';
import { generos, generosDestacados } from '@/lib/categorias';
import { nombreGenero } from '@/lib/generos';
import { PUBLICADOS, paramsDeIdioma } from '@/lib/publicables';

/**
 * Hub de género, en español e inglés: «manhwa isekai» y «isekai manhwa» son
 * búsquedas distintas con públicos distintos. La lista de obras es la misma;
 * cada tarjeta enlaza a la ficha en el idioma en que exista (NovelaCard).
 */
export async function getStaticPaths() {
  const gs = [...(await generos()).keys()];
  return paramsDeIdioma().flatMap(({ idioma }) => gs.map((categoria) => ({ params: { idioma, categoria } })));
}

const idioma = idiomaDeRuta(Astro.url.pathname);
const dic = t(idioma);
const slug = Astro.params.categoria!;

const gs = await generos();
const genero = gs.get(slug)!;
const nombre = nombreGenero(genero.nombre, idioma);

const T = {
  es: {
    titulo: `Manhwas y novelas de ${nombre} — Leer en español · ManhwaToNovel`,
    desc: `Los mejores manhwas y novelas ligeras de ${nombre}, con sus títulos alternativos, el último capítulo y dónde leerlos. ${genero.obras.length} obras.`,
    h1: `Manhwas y novelas de ${nombre}`,
    intro: `${genero.obras.length} obras de ${nombre}: manhwas y sus novelas ligeras, con títulos alternativos y dónde leerlas gratis.`,
    mas: (n: number) => `Y ${n} más: `,
    explorar: 'explora todo el catálogo',
    otros: 'Otros géneros',
  },
  en: {
    titulo: `${nombre} Manhwa & Light Novels — Where to Read · ManhwaToNovel`,
    desc: `The best ${nombre} manhwa and light novels, with their alternative titles, latest chapter and where to read them. ${genero.obras.length} series.`,
    h1: `${nombre} manhwa and novels`,
    intro: `${genero.obras.length} ${nombre} series: manhwa and their light novels, with alternative titles and where to read them for free.`,
    mas: (n: number) => `And ${n} more: `,
    explorar: 'browse the full catalog',
    otros: 'Other genres',
  },
}[idioma === 'en' ? 'en' : 'es'];

// Se listan hasta 96: suficiente para el hub y para pasar autoridad; el resto
// del género se alcanza igual por el catálogo paginado.
const TOPE = 96;
// En /en/ con el título inglés: getNovelas('en') ya pone el inglés de principal.
const locales = new Map((await getNovelas(idioma)).map((n) => [n.slug, n]));
const obras = genero.obras.slice(0, TOPE).map((n) => locales.get(n.slug) ?? n);
const conFormatos = await Promise.all(
  obras.map(async (novela) => ({ novela, formatos: formatos(await getCapitulosExternos(novela.slug)) })),
);

// Otros géneros, para enlazar hubs entre sí (más malla interna, más contexto).
const otros = (await generosDestacados()).filter((g) => g.slug !== slug).slice(0, 14);

const ruta_migas = migas(Astro.site, [
  { nombre: dic.navInicio, href: ruta(idioma) },
  { nombre: dic.catalogo, href: ruta(idioma, '/novelas') },
  { nombre, href: ruta(idioma, `/categoria/${slug}`) },
]);

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'CollectionPage',
  name: T.h1,
  inLanguage: idioma,
  numberOfItems: genero.obras.length,
};
---

<Base titulo={T.titulo} descripcion={T.desc} anchoCompleto idiomas={PUBLICADOS} jsonLd={[jsonLd, ruta_migas]}>
  <nav class="text-sm text-base-400 mb-4" aria-label="breadcrumb">
    <a href={ruta(idioma)} class="hover:text-acento-500">{dic.navInicio}</a>
    <span class="mx-1.5">/</span>
    <a href={ruta(idioma, '/novelas')} class="hover:text-acento-500">{dic.catalogo}</a>
    <span class="mx-1.5">/</span>
    <span class="text-base-500">{nombre}</span>
  </nav>

  <h1 class="text-2xl sm:text-3xl font-bold tracking-tight text-base-800 dark:text-base-50">{T.h1}</h1>
  <p class="mt-2 text-base-500 max-w-2xl">{T.intro}</p>

  <div class="mt-6 grid grid-cols-1 sm:grid-cols-2 gap-4">
    {conFormatos.map(({ novela, formatos }) => <NovelaCard novela={novela} formatos={formatos} />)}
  </div>

  {genero.obras.length > TOPE && (
    <p class="mt-6 text-sm text-base-500">
      {T.mas(genero.obras.length - TOPE)}
      <a href={ruta(idioma, '/novelas')} class="text-acento-500 underline">{T.explorar}</a>.
    </p>
  )}

  <nav class="mt-10 border-t border-base-300/40 dark:border-base-700/40 pt-6" aria-label={T.otros}>
    <h2 class="font-semibold text-base-800 dark:text-base-100 mb-3">{T.otros}</h2>
    <div class="flex flex-wrap gap-2">
      {otros.map((g) => (
        <a href={ruta(idioma, `/categoria/${g.slug}`)} class="neu-sm neu-press rounded-xl px-3 py-1.5 text-sm">
          {nombreGenero(g.nombre, idioma)} <span class="text-base-400 tabular-nums">{g.obras.length}</span>
        </a>
      ))}
    </div>
  </nav>
</Base>
