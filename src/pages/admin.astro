---
/**
 * ─────────────────────────────────────────────────────────────────────────────
 * PANEL DE ADMINISTRACIÓN
 * ─────────────────────────────────────────────────────────────────────────────
 * Página estática que habla con Supabase desde el navegador. No hay servidor,
 * no hay build especial y no hay una segunda app que mantener.
 *
 * Lo que impide que cualquiera edite el catálogo NO es esta página: es RLS.
 * Las políticas de schema-catalogo.sql solo dejan escribir a los correos de la
 * tabla `admins`. Si un desconocido abre /admin, inicia sesión y pulsa guardar,
 * Postgres le devuelve un error. Por eso la página puede ser pública.
 *
 * Alta de admin, una sola vez, en el SQL Editor:
 *   insert into public.admins values ('joseluisariasflores01@gmail.com');
 */
import '@/styles/global.css';
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex, nofollow" />
    <title>Admin · ManhwaToNovel</title>
    <style>
      [data-obras].solo-rotas li:not([data-rota]) {
        display: none;
      }
    </style>
  </head>
  <body class="min-h-dvh bg-base-100 dark:bg-base-900 text-base-800 dark:text-base-100">
    <main class="mx-auto max-w-4xl p-4 sm:p-8 grid gap-6 overflow-x-hidden">
      <header class="flex flex-wrap items-center gap-x-3 gap-y-2">
        <h1 class="text-xl font-bold">Admin</h1>
        <span data-quien class="text-sm text-base-400 truncate min-w-0 max-w-full"></span>
        <button data-entrar class="neu-sm rounded-xl px-3 py-1.5 text-sm ml-auto shrink-0">Entrar con Google</button>
        <button data-salir hidden class="neu-sm rounded-xl px-3 py-1.5 text-sm ml-auto shrink-0">Salir</button>
      </header>

      <p data-aviso class="neu-inset rounded-xl px-4 py-3 text-sm text-base-500"></p>

      <section data-panel hidden class="grid gap-6">
        <!-- ── Obras ─────────────────────────────────────────────────────── -->
        <div class="grid gap-3">
          <div class="flex items-center gap-3">
            <h2 class="font-semibold">Obras</h2>
            <span data-conteo class="text-sm text-base-400 tabular-nums"></span>
            <label class="ml-auto flex items-center gap-1.5 text-xs text-base-400 whitespace-nowrap">
              <input type="checkbox" data-solo-rotas /> solo imagen rota
            </label>
          </div>
          <!-- Buscador en su propia fila y a todo el ancho: en el header con ml-auto
               se salía por la derecha en móvil y no se veía. -->
          <input
            data-buscar
            type="search"
            placeholder="Buscar por título o slug…"
            class="neu-inset rounded-xl px-4 py-2.5 text-sm w-full bg-transparent outline-none"
          />
          <ul data-obras class="grid gap-2"></ul>
        </div>

        <!-- ── Editor de una obra ────────────────────────────────────────── -->
        <form data-editor hidden class="neu rounded-2xl p-4 grid gap-3">
          <div class="flex items-start gap-4">
            <img data-vista alt="" class="w-24 aspect-[7/10] object-cover rounded-xl neu-sm bg-base-200" />
            <div class="grid gap-2 flex-1 min-w-0">
              <label class="grid gap-1 text-sm">
                URL de la portada
                <input name="portada_url" class="neu-inset rounded-xl px-3 py-2 bg-transparent outline-none" />
              </label>
              <div class="flex items-center gap-2 text-xs text-base-400">
                <span data-rota-hint hidden class="text-rose-500">⚠ imagen rota</span>
                <label class="neu-sm rounded-lg px-2 py-1 cursor-pointer ml-auto">
                  Subir imagen
                  <input data-subir type="file" accept="image/*" class="hidden" />
                </label>
              </div>
              <label class="grid gap-1 text-sm">
                Título
                <input name="titulo" required class="neu-inset rounded-xl px-3 py-2 bg-transparent outline-none" />
              </label>
            </div>
          </div>

          <label class="grid gap-1 text-sm">
            Títulos alternativos <span class="text-base-400">(uno por línea — es lo que trae tráfico de otros idiomas)</span>
            <textarea name="titulos_alternativos" rows="3" class="neu-inset rounded-xl px-3 py-2 bg-transparent outline-none"></textarea>
          </label>

          <label class="grid gap-1 text-sm">
            Sinopsis <span class="text-base-400">(se traduce a los 7 idiomas en el build; déjala vacía si no la vas a revisar)</span>
            <textarea name="sinopsis" rows="4" class="neu-inset rounded-xl px-3 py-2 bg-transparent outline-none"></textarea>
          </label>

          <div class="grid sm:grid-cols-3 gap-3 text-sm">
            <label class="grid gap-1">
              Tipo
              <select name="tipo" class="neu-inset rounded-xl px-3 py-2 bg-transparent outline-none">
                <option value="manhwa">manhwa</option>
                <option value="novela">novela</option>
                <option value="ambos">ambos</option>
              </select>
            </label>
            <label class="grid gap-1">
              Estado
              <select name="estado" class="neu-inset rounded-xl px-3 py-2 bg-transparent outline-none">
                <option>En emisión</option>
                <option>Finalizado</option>
              </select>
            </label>
            <label class="grid gap-1">
              Categorías <span class="text-base-400">(coma)</span>
              <input name="categorias" class="neu-inset rounded-xl px-3 py-2 bg-transparent outline-none" />
            </label>
          </div>

          <div class="flex flex-wrap items-center gap-x-4 gap-y-2 text-sm">
            <label class="flex items-center gap-2"><input type="checkbox" name="publicada" /> Publicada</label>
            <label class="flex items-center gap-2"><input type="checkbox" name="destacada" /> Destacada</label>
            <span data-editor-msg class="text-xs text-acento-600 dark:text-acento-400 ml-auto"></span>
            <button class="neu-sm rounded-xl px-4 py-2 font-medium text-acento-500 shrink-0">Guardar</button>
          </div>

          <div class="grid gap-2 border-t border-base-200 dark:border-base-700 pt-3">
            <h3 class="text-sm font-semibold">Fuentes de esta obra</h3>
            <ul data-fuentes class="grid gap-2 text-sm"></ul>
          </div>

          <div class="grid gap-2 border-t border-base-200 dark:border-base-700 pt-3">
            <h3 class="text-sm font-semibold">Unir otra ficha en esta</h3>
            <p class="text-xs text-base-400">
              Busca la ficha duplicada (la misma obra en otro idioma o formato). Sus fuentes y capítulos se mueven
              aquí, sus títulos pasan a alternativos y esa ficha se borra. No se puede deshacer.
            </p>
            <input
              data-unir-buscar
              type="search"
              placeholder="Buscar ficha a absorber…"
              class="neu-inset rounded-xl px-3 py-2 text-sm bg-transparent outline-none"
            />
            <ul data-unir-res class="grid gap-1 text-sm"></ul>
          </div>
        </form>

        <!-- ── Sitios ────────────────────────────────────────────────────── -->
        <div class="grid gap-3">
          <h2 class="font-semibold">
            Sitios <span class="text-sm font-normal text-base-400">— cada uno se recorre entero cada noche</span>
          </h2>
          <ul data-sitios class="grid gap-2 text-sm"></ul>
          <form data-nuevo-sitio class="neu rounded-2xl p-4 grid sm:grid-cols-2 gap-3 text-sm">
            <input name="nombre" required placeholder="Nombre" class="neu-inset rounded-xl px-3 py-2 bg-transparent outline-none" />
            <input
              name="url_series"
              required
              placeholder="https://sitio.com/manga/page/{page}/"
              class="neu-inset rounded-xl px-3 py-2 bg-transparent outline-none"
            />
            <select name="plataforma" class="neu-inset rounded-xl px-3 py-2 bg-transparent outline-none">
              <option value="mangadex">mangadex (API, recomendado)</option>
              <option value="madara">madara</option>
              <option value="mangareader">mangareader</option>
              <option value="sheet">sheet (Google Sheet / Apps Script)</option>
              <option value="wetriedtls">wetriedtls (una novela por URL)</option>
              <option value="olympus">olympus (enlace a la serie)</option>
              <option value="manhwaweb">manhwaweb (enlace a la serie)</option>
              <option value="blogger">blogger (blog con feed)</option>
              <option value="css">css (selectores a mano)</option>
            </select>
            <select name="tipo" class="neu-inset rounded-xl px-3 py-2 bg-transparent outline-none">
              <option value="manhwa">manhwa</option>
              <option value="novela">novela</option>
            </select>
            <input name="idioma" value="es" placeholder="idioma" class="neu-inset rounded-xl px-3 py-2 bg-transparent outline-none" />
            <input name="paginas" type="number" value="5" min="1" class="neu-inset rounded-xl px-3 py-2 bg-transparent outline-none" />
            <button class="neu-sm rounded-xl px-4 py-2 font-medium text-acento-500 sm:col-span-2">
              Añadir sitio
            </button>
          </form>
          <p class="text-xs text-base-400">
            Antes de añadirlo, compruébalo sin escribir nada:
            <code>node scripts/descubrir.mjs --probar='URL' --plataforma=madara</code>
          </p>
        </div>
      </section>
    </main>

    <script>
      import { loginConGoogle, logout, supabase } from '@/lib/supabaseClient';

      const $ = <T extends HTMLElement>(s: string) => document.querySelector<T>(s)!;
      const aviso = $('[data-aviso]');
      const panel = $<HTMLElement>('[data-panel]');
      const editor = $<HTMLFormElement>('[data-editor]');

      const decir = (t: string) => (aviso.textContent = t);
      // Mensaje pegado al editor: el aviso de arriba queda fuera de pantalla
      // mientras editas abajo, así que "no salía nada" al guardar. Se pinta en
      // ambos sitios.
      const decirEditor = (t: string) => {
        const el = document.querySelector('[data-editor-msg]');
        if (el) el.textContent = t;
        decir(t);
      };

      if (!supabase) {
        decir('Sin PUBLIC_SUPABASE_URL / PUBLIC_SUPABASE_ANON_KEY: el panel no puede conectarse.');
      } else {
        const db = supabase;
        let obras: any[] = [];
        let actual: any = null;

        $('[data-entrar]').addEventListener('click', () => loginConGoogle());
        $('[data-salir]').addEventListener('click', () => logout());

        db.auth.onAuthStateChange((_e, sesion) => arrancar(sesion?.user?.email ?? null));
        db.auth.getSession().then(({ data }) => arrancar(data.session?.user?.email ?? null));

        async function arrancar(email: string | null) {
          $('[data-quien]').textContent = email ?? '';
          $('[data-entrar]').hidden = Boolean(email);
          $('[data-salir]').hidden = !email;
          if (!email) return decir('Inicia sesión para editar el catálogo.');

          // Esto solo decide qué se dibuja. Quien de verdad manda es RLS: aunque
          // alguien se saltara este if, el UPDATE le rebotaría en Postgres.
          const { data: yo } = await db.from('admins').select('email').eq('email', email).maybeSingle();
          if (!yo) {
            return decir(
              `${email} no está en la tabla admins. Añádelo en el SQL Editor: insert into public.admins values ('${email}');`,
            );
          }
          decir('');
          panel.hidden = false;
          await Promise.all([cargarObras(), cargarSitios()]);
        }

        // ── Obras ──────────────────────────────────────────────────────────
        async function cargarObras(q = '') {
          let sel = db.from('obras').select('*').order('titulo').limit(200);
          // Busca en título Y slug: así variantes como "Zenit"/"Zenith" o con/sin
          // "del" salen juntas y se pueden unir. Se limpian los caracteres que
          // rompen la sintaxis del filtro or de PostgREST (coma, paréntesis).
          const term = q.replace(/[,()*]/g, ' ').trim();
          if (term) sel = sel.or(`titulo.ilike.%${term}%,slug.ilike.%${term}%`);
          const { data, error } = await sel;
          if (error) return decir(error.message);
          obras = data ?? [];
          $('[data-conteo]').textContent = `${obras.length}${obras.length === 200 ? '+' : ''}`;
          $('[data-obras]').innerHTML = obras
            .map(
              (o) => `<li><button data-slug="${o.slug}"
                class="neu-sm rounded-xl px-3 py-2 w-full text-left flex items-center gap-3">
                <span class="truncate flex-1 min-w-0">${o.titulo}</span>
                <span class="text-xs text-base-400 shrink-0">${o.tipo}</span>
                ${o.publicada ? '' : '<span class="text-xs text-amber-500">oculta</span>'}
              </button></li>`,
            )
            .join('');
          $('[data-obras]')
            .querySelectorAll<HTMLButtonElement>('[data-slug]')
            .forEach((b) => {
              b.addEventListener('click', () => abrir(b.dataset.slug!));
              // Marca las de imagen rota (o sin portada) para poder filtrarlas y arreglarlas.
              const o = obras.find((x) => x.slug === b.dataset.slug);
              imagenRota(o?.portada_url).then((rota) => {
                if (!rota) return;
                b.closest('li')!.dataset.rota = '1';
                b.insertAdjacentHTML('beforeend', '<span class="text-xs text-rose-500">rota</span>');
              });
            });
        }

        // Carga la URL en un <img> aparte: si dispara error (o no hay URL), rota.
        function imagenRota(url?: string): Promise<boolean> {
          return new Promise((res) => {
            if (!url) return res(true);
            const img = new Image();
            const t = setTimeout(() => res(true), 8000);
            img.onload = () => (clearTimeout(t), res(false));
            img.onerror = () => (clearTimeout(t), res(true));
            img.src = url;
          });
        }

        $<HTMLInputElement>('[data-solo-rotas]').addEventListener('change', (e) =>
          $('[data-obras]').classList.toggle('solo-rotas', (e.target as HTMLInputElement).checked),
        );

        async function abrir(slug: string) {
          actual = obras.find((o) => o.slug === slug);
          editor.hidden = false;
          const f = editor as any;
          f.portada_url.value = actual.portada_url ?? '';
          f.titulo.value = actual.titulo ?? '';
          f.titulos_alternativos.value = (actual.titulos_alternativos ?? []).join('\n');
          f.sinopsis.value = actual.sinopsis ?? '';
          f.tipo.value = actual.tipo;
          f.estado.value = actual.estado;
          f.categorias.value = (actual.categorias ?? []).join(', ');
          f.publicada.checked = actual.publicada;
          f.destacada.checked = actual.destacada;
          $<HTMLImageElement>('[data-vista]').src = actual.portada_url || '';
          imagenRota(actual.portada_url).then((rota) => ($('[data-rota-hint]').hidden = !rota));
          $<HTMLInputElement>('[data-unir-buscar]').value = '';
          $('[data-unir-res]').innerHTML = '';
          editor.scrollIntoView({ behavior: 'smooth', block: 'start' });
          await cargarFuentes(slug);
        }

        // Vista previa en vivo: pegar una URL de portada y verla antes de guardar
        // evita el caso clásico de publicar 200 obras con la imagen rota.
        (editor as any).portada_url.addEventListener('input', (e: Event) => {
          const url = (e.target as HTMLInputElement).value;
          $<HTMLImageElement>('[data-vista]').src = url;
          imagenRota(url).then((rota) => ($('[data-rota-hint]').hidden = !rota));
        });

        // Subir una imagen desde el PC → Supabase Storage → rellena la URL. Útil
        // cuando la portada de origen se cayó y no hay otra URL a mano. Requiere
        // el bucket de supabase/schema-storage.sql.
        $<HTMLInputElement>('[data-subir]').addEventListener('change', async (e) => {
          const file = (e.target as HTMLInputElement).files?.[0];
          if (!file || !actual) return;
          const ext = (file.name.split('.').pop() || 'jpg').toLowerCase();
          const ruta = `${actual.slug}-${Date.now()}.${ext}`;
          decirEditor('Subiendo imagen…');
          const { error } = await db.storage
            .from('portadas')
            .upload(ruta, file, { upsert: true, contentType: file.type });
          if (error) return decirEditor(`No se subió: ${error.message} (¿corriste supabase/schema-storage.sql?)`);
          const url = db.storage.from('portadas').getPublicUrl(ruta).data.publicUrl;
          (editor as any).portada_url.value = url;
          $<HTMLImageElement>('[data-vista]').src = url;
          $('[data-rota-hint]').hidden = true;
          decirEditor('Imagen subida. Pulsa Guardar para aplicarla.');
        });

        // ── Unir fichas (misma obra en otro idioma/formato) ────────────────────
        let debounceUnir: number;
        $('[data-unir-buscar]').addEventListener('input', (e) => {
          clearTimeout(debounceUnir);
          const q = (e.target as HTMLInputElement).value.trim();
          debounceUnir = window.setTimeout(() => buscarUnir(q), 300);
        });

        async function buscarUnir(q: string) {
          const cont = $('[data-unir-res]');
          if (!q || !actual) return (cont.innerHTML = '');
          const { data } = await db.from('obras').select('slug, titulo, tipo').ilike('titulo', `%${q}%`).limit(8);
          const res = (data ?? []).filter((o) => o.slug !== actual.slug);
          cont.innerHTML =
            res
              .map(
                (o) => `<li><button type="button" data-src="${o.slug}"
                  class="neu-sm rounded-xl px-3 py-2 w-full text-left flex items-center gap-2">
                  <span class="truncate flex-1 min-w-0">${o.titulo}</span>
                  <span class="text-xs text-base-400 shrink-0">${o.tipo}</span>
                </button></li>`,
              )
              .join('') || '<li class="text-base-400">Sin coincidencias.</li>';
          cont.querySelectorAll<HTMLButtonElement>('[data-src]').forEach((b) => {
            const o = res.find((x) => x.slug === b.dataset.src)!;
            b.addEventListener('click', () => unir(o.slug, o.titulo));
          });
        }

        // Espejo de scripts/fusionar.mjs, en el navegador. RLS deja hacerlo solo
        // al admin. Pasos ordenados: mover antes de borrar, para que un fallo a
        // mitad deje la src vacía (recuperable), nunca capítulos huérfanos.
        async function unir(src: string, tituloSrc: string) {
          if (
            !confirm(
              `¿Unir "${tituloSrc}" dentro de "${actual.titulo}"?\n\nSus fuentes y capítulos se moverán aquí y esa ficha se borrará. No se puede deshacer.`,
            )
          )
            return;
          const dst = actual.slug;
          decir('Uniendo…');
          const { data: fus } = await db.from('obras').select('*').in('slug', [dst, src]);
          const oDst = fus?.find((o) => o.slug === dst);
          const oSrc = fus?.find((o) => o.slug === src);
          if (!oDst || !oSrc) return decir('No se encontró alguna de las fichas.');

          const alts = [
            ...new Set(
              [oDst.titulo, ...(oDst.titulos_alternativos ?? []), oSrc.titulo, ...(oSrc.titulos_alternativos ?? [])]
                .filter((t) => t && t !== oDst.titulo),
            ),
          ];
          const tipo =
            oDst.tipo === 'ambos' || oSrc.tipo === 'ambos'
              ? 'ambos'
              : oDst.tipo === oSrc.tipo
                ? oDst.tipo
                : 'ambos';

          for (const [t, col] of [
            ['fuentes', 'obra_slug'],
            ['capitulos_externos', 'obra_slug'],
            ['equivalencias', 'novela_slug'],
          ] as const) {
            const { error } = await db.from(t).update({ [col]: dst }).eq(col, src);
            if (error) return decir(`${t}: ${error.message}`);
          }
          let r = await db
            .from('obras')
            .update({ tipo, titulos_alternativos: alts, portada_url: oDst.portada_url || oSrc.portada_url || '' })
            .eq('slug', dst);
          if (r.error) return decir(`obra: ${r.error.message}`);
          r = await db.from('obras').delete().eq('slug', src);
          if (r.error) return decir(`borrar: ${r.error.message}`);

          decir(`Unida: "${oSrc.titulo}" absorbida en "${oDst.titulo}". Se verá en el próximo build.`);
          await cargarObras($<HTMLInputElement>('[data-buscar]').value);
          await abrir(dst);
        }

        editor.addEventListener('submit', async (e) => {
          e.preventDefault();
          const f = editor as any;
          const lista = (s: string, sep: string) =>
            s.split(sep).map((x: string) => x.trim()).filter(Boolean);
          const { error } = await db
            .from('obras')
            .update({
              portada_url: f.portada_url.value.trim(),
              titulo: f.titulo.value.trim(),
              titulos_alternativos: lista(f.titulos_alternativos.value, '\n'),
              sinopsis: f.sinopsis.value.trim(),
              tipo: f.tipo.value,
              estado: f.estado.value,
              categorias: lista(f.categorias.value, ','),
              publicada: f.publicada.checked,
              destacada: f.destacada.checked,
            })
            .eq('slug', actual.slug);
          decirEditor(
            error
              ? `No se guardó: ${error.message}`
              : 'Guardado ✓ — aparecerá en el sitio tras la próxima reconstrucción (el build nocturno o un deploy).',
          );
          if (!error) await cargarObras($<HTMLInputElement>('[data-buscar]').value);
        });

        let debounce: number;
        $('[data-buscar]').addEventListener('input', (e) => {
          clearTimeout(debounce);
          debounce = window.setTimeout(() => cargarObras((e.target as HTMLInputElement).value), 250);
        });

        // ── Fuentes ────────────────────────────────────────────────────────
        async function cargarFuentes(slug: string) {
          const { data } = await db.from('fuentes').select('*').eq('obra_slug', slug);
          $('[data-fuentes]').innerHTML =
            (data ?? [])
              .map(
                (f) => `<li class="neu-inset rounded-xl px-3 py-2 flex flex-wrap items-center gap-x-3 gap-y-1">
                  <label class="flex items-center gap-2 min-w-0">
                    <input type="checkbox" class="shrink-0" data-fuente="${f.id}" ${f.activa ? 'checked' : ''}> <span class="truncate">${f.nombre}</span>
                  </label>
                  <span class="text-xs text-base-400 shrink-0">${f.tipo}/${f.idioma}</span>
                  <a href="${f.url_listado}" target="_blank" rel="noopener nofollow"
                     class="text-xs text-acento-500 ml-auto truncate max-w-full sm:max-w-[40%]">${f.url_listado}</a>
                </li>`,
              )
              .join('') || '<li class="text-base-400">Ninguna todavía.</li>';
          $('[data-fuentes]')
            .querySelectorAll<HTMLInputElement>('[data-fuente]')
            .forEach((c) =>
              c.addEventListener('change', async () => {
                const { error } = await db
                  .from('fuentes')
                  .update({ activa: c.checked })
                  .eq('id', c.dataset.fuente);
                if (error) {
                  c.checked = !c.checked;
                  decir(error.message);
                }
              }),
            );
        }

        // ── Sitios ─────────────────────────────────────────────────────────
        async function cargarSitios() {
          const { data } = await db.from('sitios').select('*').order('nombre');
          $('[data-sitios]').innerHTML =
            (data ?? [])
              .map(
                (s) => `<li class="neu-inset rounded-xl px-3 py-2 flex flex-wrap items-center gap-x-3 gap-y-1">
                  <label class="flex items-center gap-2 min-w-0">
                    <input type="checkbox" class="shrink-0" data-sitio="${s.id}" ${s.activo ? 'checked' : ''}> <span class="truncate">${s.nombre}</span>
                  </label>
                  <span class="text-xs text-base-400 shrink-0">${s.plataforma} · ${s.tipo}/${s.idioma}</span>
                  <span class="text-xs text-base-400 ml-auto shrink-0">${
                    s.ultimo_descubrimiento ? new Date(s.ultimo_descubrimiento).toLocaleDateString() : 'sin recorrer'
                  }</span>
                </li>`,
              )
              .join('') || '<li class="text-base-400">Ninguno todavía.</li>';
          $('[data-sitios]')
            .querySelectorAll<HTMLInputElement>('[data-sitio]')
            .forEach((c) =>
              c.addEventListener('change', async () => {
                const { error } = await db.from('sitios').update({ activo: c.checked }).eq('id', c.dataset.sitio);
                if (error) {
                  c.checked = !c.checked;
                  decir(error.message);
                }
              }),
            );
        }

        $<HTMLFormElement>('[data-nuevo-sitio]').addEventListener('submit', async (e) => {
          e.preventDefault();
          const f = e.target as any;
          const { error } = await db.from('sitios').insert({
            nombre: f.nombre.value.trim(),
            url_series: f.url_series.value.trim(),
            plataforma: f.plataforma.value,
            tipo: f.tipo.value,
            idioma: f.idioma.value.trim(),
            paginas: Number(f.paginas.value),
          });
          decir(error ? error.message : 'Sitio añadido. Se recorrerá en la próxima corrida nocturna.');
          if (!error) {
            f.reset();
            await cargarSitios();
          }
        });
      }
    </script>
  </body>
</html>
