{
  "name": "manhwa-to-novel",
  "type": "module",
  "version": "0.1.0",
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "traducir": "node --env-file-if-exists=.env scripts/traducir.mjs",
    "descubrir": "node --env-file-if-exists=.env scripts/descubrir.mjs",
    "enriquecer": "node --env-file-if-exists=.env scripts/enriquecer.mjs",
    "scrapear": "node --env-file-if-exists=.env scripts/scrapear.mjs",
    "sugerir": "node --env-file-if-exists=.env scripts/sugerir-fusiones.mjs",
    "avisar": "node --env-file-if-exists=.env scripts/indexnow.mjs",
    "palabras": "node scripts/palabras.mjs",
    "trafico": "node scripts/gsc-trafico.mjs",
    "pinterest": "node --env-file-if-exists=.env scripts/pinterest.mjs",
    "dominios": "node --env-file-if-exists=.env scripts/dominios.mjs",
    "fusionar": "node --env-file-if-exists=.env scripts/fusionar.mjs",
    "test:scrapear": "node scripts/scrapear.test.mjs && node scripts/emparejar.test.mjs",
    "verificar": "node --env-file-if-exists=.env scripts/verificar-supabase.mjs",
    "preview": "astro preview",
    "check": "astro check",
    "test:portada": "node --experimental-strip-types tests/portada.test.ts",
    "test:capitulo": "node --experimental-strip-types tests/capitulo.test.ts",
    "test:leer": "node --experimental-strip-types tests/leer.test.ts",
    "test:seo": "node --experimental-strip-types src/lib/indexacion.test.ts && node --experimental-strip-types src/lib/i18n.test.ts && node --experimental-strip-types tests/middleware.test.ts"
  },
  "dependencies": {
    "@astrojs/sitemap": "^3.2.1",
    "@supabase/supabase-js": "^2.47.10",
    "@tailwindcss/vite": "^4.0.0",
    "astro": "^5.1.1",
    "tailwindcss": "^4.0.0"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.4",
    "cheerio": "^1.2.0",
    "typescript": "^5.7.2"
  }
}
